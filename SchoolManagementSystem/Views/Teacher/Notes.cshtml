@model SchoolManagementSystem.ViewModel.Teacher.NoteDisplayViewModel

@{
    ViewData["Title"] = "ملاحظات المعلم";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<link class="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/Teacher/main.css" />

<div class="dashboard-container" dir="rtl">
    <button class="menu-toggle" id="menuToggle">
        <i class="fas fa-bars"></i>
    </button>
    <aside class="sidebar" id="sidebar">
        <div class="logo">
            <div class="user-info">
                <div class="user-avatar">
                    @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                    {
                        <text>@Model.NavigationInfo.FullName[0]</text>
                    }
                    else
                    {
                        <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                    }
                </div>
                <span>@Model.NavigationInfo.FullName</span>
            </div>
        </div>
        <ul class="nav-links">
            <li><a asp-controller="Teacher" asp-action="Teacherdashboard">الصفحة الرئيسية</a></li>
            <li><a asp-controller="Teacher" asp-action="Notes" class="active">الملاحظات والتنبيهات </a></li>
            <li><a asp-controller="Teacher" asp-action="Students">الطلاب</a></li>
            <li><a asp-controller="Teacher" asp-action="Schedule">الجدول الدراسي</a></li>
            <li><a asp-controller="Teacher" asp-action="Grades">الدرجات</a></li>
            <li><a asp-controller="Teacher" asp-action="Notesstudents"> ملاحظات الطلاب </a></li>
            <li><a asp-controller="Teacher" asp-action="Assignments">الواجبات</a></li>
            <li><a asp-controller="Teacher" asp-action="Exams">الاختبارات</a></li>
            <li><a asp-controller="Teacher" asp-action="Setting">تعديل البيانات</a></li>
        </ul>
        <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
    </aside>

    <div class="main-content">
        <div class="content-card">
            <div class="text-center mb-4">
                <h2 class="page-title">
                    <i class="bi bi-journal-text me-2"></i>جدول الملاحظات الواردة
                </h2>
                <p class="text-muted small">هنا تجد جميع الملاحظات والتنبيهات المرسلة إليك من الإدارة أو أولياء الأمور.</p>
            </div>

            @if (Model.Notes == null || !Model.Notes.Any())
            {
                <div class="alert alert-light text-center p-5 border rounded-3" role="alert">
                    <i class="bi bi-info-circle fs-1 text-muted d-block mb-3"></i>
                    <h5 class="fw-bold text-secondary">لا توجد ملاحظات حالياً</h5>
                </div>
            }
            else
            {
                <div class="table-container">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 text-center">
                            <thead>
                                <tr>
                                    <th scope="col" style="width: 25%;">تاريخ الإضافة</th>
                                    <th scope="col" style="width: 50%;">الملاحظة</th>
                                    <th scope="col" style="width: 25%;">كاتب الملاحظة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Notes)
                                {
                                    <tr>
                                        <td class="text-muted small">
                                            <div><i class="bi bi-calendar3 me-1 text-info"></i> @item.FormattedAddedDate</div>
                                            <div class="text-black-50 mt-1" style="font-size: 11px;">@item.AddedDate.ToString("hh:mm tt")</div>
                                        </td>
                                        <td class="text-wrap px-3">
                                            @item.NoteDetails
                                        </td>
                                        <td class="fw-bold text-secondary">
                                            <i class="bi bi-person-circle text-primary opacity-75 me-1"></i>
                                            @item.WriterName
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="text-start mt-3">
                    <span class="badge rounded-pill bg-primary px-3 py-2">إجمالي الملاحظات: @Model.Notes.Count</span>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // كود التحكم في القائمة الجانبية (Sidebar)
    const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.getElementById("sidebar");

    menuToggle.addEventListener("click", () => {
        sidebar.classList.toggle("active");
    });

    document.addEventListener("click", function (e) {
        if (
            window.innerWidth <= 992 &&
            !sidebar.contains(e.target) &&
            !menuToggle.contains(e.target)
        ) {
            sidebar.classList.remove("active");
        }
    });

    // كود الريفرش التلقائي بمجرد إغلاق البارشيال فيو (Modal)
    document.addEventListener("DOMContentLoaded", function () {
        // الاستماع لحدث إغلاق أي مودال تابع لـ Bootstrap في الصفحة
        document.addEventListener('hidden.bs.modal', function () {
            location.reload();
        });
    });
</script>