@{
    ViewData["Title"] = "تعديل درجة";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/Teacher/addandeditgrades.css" />

    <title>تعديل درجة</title>

   
</head>
<body>

    <div class="form-container">

        <h2>تعديل درجة</h2>

        <form>

            <div class="form-group">
                <label>اسم الطالب</label>

                <select class="form-control">
                    <option>أحمد محمد</option>
                    <option>محمد خالد</option>
                    <option>سارة علي</option>
                </select>
            </div>

            <div class="form-group">
                <label>المادة</label>

                <select class="form-control">
                    <option>الرياضيات</option>
                    <option>اللغة العربية</option>
                    <option>العلوم</option>
                </select>
            </div>

            <div class="form-group">
                <label>الدرجة</label>

                <input type="number"
                       class="form-control"
                       value="95"
                       min="0"
                       max="100" />
            </div>

            <div class="form-group">
                <label>تاريخ الدرجة</label>

                <input type="date"
                       class="form-control"
                       value="2026-06-12" />
            </div>

            <div class="form-actions">

                <button type="submit" class="btn">
                    حفظ
                </button>

                <a asp-controller="Teacher"
                   asp-action="Grades"
                   class="btn btn-cancel">
                    إلغاء
                </a>

            </div>
                    </form>

    </div>

</body>
</html>