@model List<SchoolManagementSystem.ViewModel.Teacher.HomeworkAnswerViewModel>
@{
    ViewData["Title"] = "تسليمات الواجبات";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/Teacher/assignment-submissions.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />


    <style>
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #718096;
        }

            .empty-state i {
                font-size: 3.5rem;
                margin-bottom: 15px;
                color: #a0aec0;
            }

            .empty-state h3 {
                font-size: 1.25rem;
                margin: 0;
                font-weight: 600;
            }

        /* تنسيق زر العودة المخصص */
        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background-color: #edf2f7;
            color: #4a5568;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .btn-back:hover {
                background-color: #e2e8f0;
                color: #2d3748;
                border-color: #a0aec0;
            }
    </style>
</head>
<body>

    <div class="table-container" style="margin:20px 0; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
            <h2 style="margin: 0; color: #2d3748;">
                <i class="fas fa-file-invoice" style="margin-left: 10px; color: #3182ce;"></i> قائمة تسليمات الطلاب
            </h2>

            <a asp-controller="Teacher" asp-action="Assignments" class="btn-back">
                <i class="fas fa-arrow-right"></i> العودة للواجبات
            </a>
        </div>

        <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: right;">
            <thead>
                <tr style="background-color: #f7fafc; border-bottom: 2px solid #e2e8f0;">
                    <th style="padding: 12px 15px;">اسم الطالب</th>
                    <th style="padding: 12px 15px;">تاريخ التسليم</th>
                    <th style="padding: 12px 15px; text-align: center;">الملف المرفق</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var submission in Model)
                    {
                        <tr style="border-bottom: 1px solid #edf2f7;">
                            <td style="padding: 12px 15px;"><strong>@submission.FullName</strong></td>
                            <td style="padding: 12px 15px;">@submission.Date.ToShortDateString()</td>
                            <td style="padding: 12px 15px; text-align: center;">
                                @if (!string.IsNullOrEmpty(submission.FileName))
                                {
                                    <a href="@submission.FileName" target="_blank" class="btn btn-small" title="عرض الملف" style="font-size: 1.5rem; text-decoration: none;">
                                        @if (submission.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="fas fa-file-pdf" style="color: #e74c3c;"></i>
                                        }
                                        else if (submission.FileName.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || submission.FileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="fas fa-file-word" style="color: #2980b9;"></i>
                                        }
                                        else if (submission.FileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || submission.FileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || submission.FileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <i class="fas fa-file-image" style="color: #27ae60;"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file-download" style="color: #718096;"></i>
                                        }
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #a0aec0; font-size: 0.9rem;">لا يوجد ملف</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="empty-state">
                            <i class="fas fa-inbox"></i>
                            <h3>لم يقم أي طالب بتسليم هذا الواجب حتى الآن</h3>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</body>
</html>
