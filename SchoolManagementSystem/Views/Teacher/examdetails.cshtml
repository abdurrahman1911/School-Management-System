@model SchoolManagementSystem.ViewModel.Teacher.ExamDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الاختبار";
}

<div class="container my-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12">

            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold mb-1" style="color: #4a90e2;"><i class="bi bi-file-earmark-text me-2"></i> تفاصيل الاختبار</h3>
                    <p class="text-muted small mb-0">عرض شامل لبيانات الامتحان والأسئلة المضافة</p>
                </div>
                <div>
                    <a href="@Url.Action("Exams")" class="btn btn-sm btn-outline-secondary me-1 px-3">
                        <i class="bi bi-arrow-right-circle me-1"></i> العودة
                    </a>
                    <a href="@Url.Action("EditExam", new { id = Model.Id })" class="btn btn-sm text-white px-3" style="background-color: #6da4f1;">
                        <i class="bi bi-pencil-square me-1"></i> تعديل
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-5 bg-white rounded-3" style="border-top: 4px solid #7cb1fa !important;">
                <div class="card-body p-4 bg-light bg-opacity-25">
                    <h4 class="card-title fw-bold mb-4 border-bottom pb-2" style="color: #3b76c4;">@Model.Name</h4>
                    <div class="row g-3">
                        <div class="col-md-4 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-book me-1"></i> المادة</span>
                                <strong class="text-dark">@Model.SubjectName</strong>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-people me-1"></i> الصف الدراسي</span>
                                <strong class="text-dark">@Model.ClassName</strong>
                            </div>
                        </div>
                        <div class="col-md-4 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-bookmark-star me-1"></i> نوع الاختبار</span>
                                <strong class="text-dark">@Model.Type</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-calendar3 me-1"></i> التاريخ</span>
                                <strong class="text-dark small">@Model.Date.ToString("yyyy-MM-dd")</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-clock me-1"></i> الوقت</span>
                                <strong class="text-dark">@Model.Time.ToString(@"hh\:mm")</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-2 bg-white rounded border border-light text-center shadow-sm">
                                <span class="text-muted d-block small fw-bold mb-1"><i class="bi bi-hourglass-split me-1"></i> المدة</span>
                                <strong class="text-dark">@Model.Duration دقيقة</strong>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="p-2 text-white rounded text-center shadow-sm" style="background-color: #5c9df5;">
                                <span class="text-white-50 d-block small fw-bold mb-1"><i class="bi bi-trophy me-1"></i> الدرجة</span>
                                <strong class="fs-6">@Model.TotalMarks درجة</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h4 class="fw-bold mb-4" style="color: #4a90e2;"><i class="bi bi-patch-question me-2"></i> أسئلة الاختبار (@Model.Questions.Count)</h4>

            @if (Model.Questions != null && Model.Questions.Any())
            {
                int questionNumber = 1;
                @foreach (var question in Model.Questions)
                {
                    <div class="card shadow-sm mb-4 border-0 rounded-3" style="border-right: 4px solid #7cb1fa !important;">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom-0">
                            <h6 class="mb-0 fw-bold text-dark">
                                <span class="badge me-2" style="background-color: #6da4f1;">سؤال @questionNumber</span> @question.Text
                            </h6>
                            <span class="badge fw-bold" style="background-color: #e1eefd; color: #2b6cb0;">@question.Mark درجات</span>
                        </div>
                        <div class="card-body p-3 pt-0">
                            <div class="row g-2">
                                @foreach (var choice in question.Choices)
                                {
                                    <div class="col-md-6">
                                        <div class="p-2.5 rounded border @(choice.IsCorrect ? "border-success bg-success bg-opacity-10" : "border-light bg-light bg-opacity-50") d-flex justify-content-between align-items-center">
                                            <span class="small fw-semibold @(choice.IsCorrect ? "text-success fw-bold" : "text-muted")">
                                                @choice.ChoiceText
                                            </span>
                                            @if (choice.IsCorrect)
                                            {
                                                <span class="badge bg-success bg-opacity-75 text-white px-2 py-1 rounded-pill small" style="font-size: 0.75rem;">
                                                    <i class="bi bi-check-lg me-1"></i> الإجابة الصحيحة
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    { questionNumber++; }
                }
            }
            else
            {
                <div class="alert alert-warning text-center shadow-sm border-0" role="alert" style="background-color: #fff3cd; color: #856404;">
                    <i class="bi bi-exclamation-triangle fs-4 d-block mb-2"></i>
                    لا توجد أسئلة مضافة لهذا الاختبار حتى الآن.
                </div>
            }

        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">