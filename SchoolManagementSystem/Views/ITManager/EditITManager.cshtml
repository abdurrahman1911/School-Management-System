@{
    Layout = null;
}

@using SchoolManagementSystem.ViewModel.ITManager;
@model AddEditITManagerViewModel;

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>اضافة مدير نظام</title>

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .text-danger {
                color: red;
                font-size: .85em;
                margin-top: 5px;
                display: block;
            }
    </style>

</head>

<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    <div class="layout">


        <aside class="sidebar">

            <div class="profile">
                <div class="user-info">

                    <div class="user-avatar">

                        @if (string.IsNullOrEmpty(Model.NavigationInfo?.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo?.FullName?[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" />
                        }

                    </div>

                    <h4>  <span>@Model.NavigationInfo?.FullName</span></h4>

                </div>
            </div>


            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>
                <li><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li class="active"><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>

                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>

                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>

                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>
                <li><a asp-controller="ITManager" asp-action="ManageSuccess">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>

                <li><a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>



        <main class="content">


            <div class="page-container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                   
                <form asp-controller="ITManager"
                      asp-action="AddNewITManager"
                      enctype="multipart/form-data">

                    
                        <input type="hidden" asp-for="ITManagerInfo.ID" />
                        <input type="hidden" asp-for="ITManagerInfo.UserID" />
                        <h1>تعديل بيانات مدير تقنية معلومات</h1>
                    

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>الاسم الأول</label>
                        <input asp-for="UserInfo.FirstName" class="form-control" />
                        <span asp-validation-for="UserInfo.FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الاسم الثاني</label>
                        <input asp-for="UserInfo.SecondName" class="form-control" />
                        <span asp-validation-for="UserInfo.SecondName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الاسم الثالث</label>
                        <input asp-for="UserInfo.ThirdName" class="form-control" />
                        <span asp-validation-for="UserInfo.ThirdName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الاسم الأخير</label>
                        <input asp-for="UserInfo.LastName" class="form-control" />
                        <span asp-validation-for="UserInfo.LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الرقم القومي (SSN)</label>
                        <input asp-for="UserInfo.SSN"  class="form-control" />
                        <span asp-validation-for="UserInfo.SSN" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الجنس</label>
                        <select asp-for="UserInfo.Gender" class="form-control">
                            <option value="">-- اختر الجنس --</option>
                            <option value="true">ذكر</option>
                            <option value="false">أنثى</option>
                        </select>
                        <span asp-validation-for="UserInfo.Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>تاريخ الميلاد</label>
                        <input asp-for="UserInfo.BirthDate" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="UserInfo.BirthDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>تاريخ التعيين</label>
                        <input asp-for="ITManagerInfo.HireDate" type="date" class="form-control" />
                        <span asp-validation-for="ITManagerInfo.HireDate" class="text-danger"></span>
                    </div>


                    <div class="form-group">
                        <label>الجنسية</label>
                        <input asp-for="UserInfo.Nationality" class="form-control" />
                        <span asp-validation-for="UserInfo.Nationality" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input asp-for="UserInfo.Phone" class="form-control" />
                        <span asp-validation-for="UserInfo.Phone" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>البريد الإلكتروني</label>
                        <input asp-for="UserInfo.Email" type="email" class="form-control" />
                        <span asp-validation-for="UserInfo.Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>المحافظة</label>
                        <input asp-for="UserInfo.Governorate" class="form-control" />
                        <span asp-validation-for="UserInfo.Governorate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>المدينة</label>
                        <input asp-for="UserInfo.City" class="form-control" />
                        <span asp-validation-for="UserInfo.City" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>المنطقة</label>
                        <input asp-for="UserInfo.Area" class="form-control" />
                        <span asp-validation-for="UserInfo.Area" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الشارع</label>
                        <input asp-for="UserInfo.Street" class="form-control" />
                        <span asp-validation-for="UserInfo.Street" class="text-danger"></span>
                    </div>


                    <div class="form-group">
                        <label>تاريخ ترك العمل</label>
                        <input asp-for="ITManagerInfo.ExitDate" type="date" class="form-control" />
                        <span asp-validation-for="ITManagerInfo.ExitDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الصورة الشخصية (اختياري)</label>
                        <input asp-for="ProfileImageFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="ProfileImageFile" class="text-danger"></span>
                    </div>

                    <div class="form-actions">
                        <a asp-controller="ITManager" asp-action="Home">إلغاء</a>
                        <button type="submit">حفظ البيانات</button>
                    </div>

                </form>

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle.addEventListener("click", () => {
        sidebar.classList.add("active");
        overlay.classList.add("active");
        menuToggle.classList.add("hidden"); // اخفاء الزر
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        menuToggle.classList.remove("hidden"); // اظهار الزر
        });
    </script>

</body>
</html>