@{
    Layout = null;
}

@using SchoolManagementSystem.ViewModel.ITManager
@model ITParentsManagementViewModel


<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة أولياء الأمور</title>


    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/parentmanagement.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

          
    <style>
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden; /* important */
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }
                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .text-danger {
                color: red;
                font-size: .85em;
                margin-top: 5px;
                display: block;
            }
    </style>

</head>


<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>


    <div class="layout">


        <aside class="sidebar">


            <div class="profile">
                <div class="user-info">

                    <div class="user-avatar">

                        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo.FullName[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" />
                        }

                    </div>

                    <h4>  <span>@Model.NavigationInfo.FullName</span></h4>

                </div>
            </div>





            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>
                <li><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li class="active"><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>

                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>

                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>

                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>
                <li><a asp-controller="ITManager" asp-action="ManageSuccess">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>

                <li><a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>


            <a asp-controller="Account"
               asp-action="Logout"
               class="logout">

                تسجيل الخروج

            </a>


        </aside>





        <main class="content">



            <div class="parent-management-container">

                @if (TempData["SuccessMessage"] != null)

                {

                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;">

                        @TempData["SuccessMessage"]

                    </div>

                }



                @if (TempData["ErrorMessage"] != null)

                {

                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;">

                        @TempData["ErrorMessage"]

                    </div>

                }

                <h1 class="page-title">
                    إدارة أولياء الأمور
                </h1>





                <div class="actions-bar">



                    <a asp-controller="ITManager"
                       asp-action="AddNewParent"
                     
                       class="btn-add">


                        <i class="fas fa-plus"></i>

                        إضافة ولي أمر


                    </a>





                    <div class="search-container">



                        <select id="searchType"
                                class="search-type">
                            <option value="">-- اختر نوع البحث --</option>


                            <option value="phone">
                                رقم الهاتف
                            </option>


                            <option value="nationalid">
                                رقم الهوية
                            </option>


                        </select>





                        <div class="search-box">



                            <i class="fas fa-search search-icon"></i>




                            <input type="text"
                                   class="search-input"
                                   placeholder="ابحث..."
                                   id="searchInput">





                            <button class="search-clear"
                                    id="clearSearch"
                                    style="display:none;background:none;border:none;cursor:pointer;">


                                <i class="fas fa-times"></i>


                            </button>



                        </div>



                    </div>


                </div>







                <div class="table-container">
                    <div class="table-wrapper">


                    <table class="parents-table"
                           id="parentsTable">



                        <thead>


                            <tr>


                                <th>
                                    الاسم
                                </th>


                                <th>
                                    رقم الهاتف
                                </th>


                                <th>
                                    عدد الأبناء
                                </th>


                                <th>
                                    الإجراءات
                                </th>


                            </tr>


                        </thead>






                        <tbody>



                            @if (Model.parents != null && Model.parents.Any())
                            {


                                foreach (var parent in Model.parents)
                                {


                                    <tr data-nationalid="@parent.SSN">



                                        <td>

                                            @parent.Name

                                        </td>




                                        <td>

                                            @parent.Phone

                                        </td>




                                        <td>

                                            @parent.SonsNumber

                                        </td>





                                        <td>


                                            <a asp-controller="ITManager"
                                                   asp-action="EditParent"
                                               asp-route-SSN="@parent.SSN"
                                               class="action-edit">



                                                <i class="fas fa-edit"></i>


                                                تعديل


                                            </a>



                                        </td>




                                    </tr>


                                }


                            }
                            else
                            {

                                <tr>

                                    <td colspan="4"
                                        style="text-align:center">

                                        لا يوجد أولياء أمور

                                    </td>

                                </tr>


                            }



                        </tbody>




                    </table>

                    </div>


                </div>





            </div>




        </main>




    </div>







    <script>


            function filterTable() {


                const searchValue =
                    searchInput.value.toLowerCase().trim();


                const searchType =
                    document.getElementById('searchType').value;



                const rows =
                    document.querySelectorAll('#parentsTable tbody tr');



                rows.forEach(row => {


                    const phoneNumber =
                        row.cells[1].textContent.toLowerCase();



                    const nationalId =
                        row.dataset.nationalid?.toLowerCase() || '';



                    let match = false;



                    if(searchType === "phone")
                    {

                        match =
                            phoneNumber.includes(searchValue);

                    }
                    else
                    {

                        match =
                            nationalId.includes(searchValue);

                    }



                    row.style.display =
                        (match || searchValue === '')
                        ? ''
                        : 'none';



                });



                clearSearchBtn.style.display =
                    searchValue ? 'inline-block' : 'none';



            }



            const searchInput =
                document.getElementById('searchInput');



            const clearSearchBtn =
                document.getElementById('clearSearch');



            searchInput.addEventListener(
                'keyup',
                filterTable
            );



            clearSearchBtn.addEventListener(
                'click',
                function()
                {

                    searchInput.value = '';

                    filterTable();

                    searchInput.focus();

                }
            );

            
                 const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.querySelector(".sidebar");
            const overlay = document.getElementById("sidebarOverlay");

            menuToggle.addEventListener("click", () => {
            sidebar.classList.add("active");
            overlay.classList.add("active");
            menuToggle.classList.add("hidden");
            });

            overlay.addEventListener("click", () => {
            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            menuToggle.classList.remove("hidden");
            });

    </script>



</body>

</html>