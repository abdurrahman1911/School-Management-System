@model SchoolManagementSystem.ViewModel.ITManager.SubjectViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
</head>

<body>

    <div class="page-container">


        <form asp-controller="ITManager"
              asp-action="EditSubject"
              method="post">
            <h1>تعديل مادة دراسية</h1>


            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label>اسم المادة</label>
                <input type="text" asp-for="Name" class="form-control" required />
            </div>

            <div class="form-group">
                <label>كود المادة</label>
                <input type="text" asp-for="Code" class="form-control" required />
            </div>

            <div class="form-group">
                <label>عدد الحصص الأسبوعية</label>
                <select asp-for="WeeklyHours" class="form-control">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </select>
            </div>

            <div class="form-actions">

                <a asp-controller="ITManager"
                   asp-action="SubjectsManagement">
                    إلغاء
                </a>

                <button type="submit">
                    حفظ التعديل
                </button>

            </div>

        </form>

    </div>

</body>
</html>