@model SchoolManagementSystem.ViewModel.ITManager.TargetEnrollementData
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل مواد الفصل للترم التالي</title>

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

    <style>
            /* Avatar Styling */
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            /* Enhanced Form Card Styling */
            .enrollment-container {
                padding: 20px;
                max-width: 1200px;
                margin: 0 auto;
            }

            .custom-card {
                background: #ffffff;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
                border: 1px solid #eef2f5;
                overflow: hidden;
            }

            .custom-card-header {
                background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                color: white;
                padding: 20px 25px;
                display: flex;
                align-items: center;
                gap: 15px;
            }

                .custom-card-header h4 {
                    margin: 0;
                    font-size: 1.25rem;
                    font-weight: 600;
                }

            .custom-card-body {
                padding: 30px;
            }

            .form-label {
                color: #334155;
                margin-bottom: 8px;
                display: block;
            }

            .form-select {
                width: 100%;
                padding: 10px 15px;
                border: 1px solid #cbd5e1;
                border-radius: 8px;
                font-size: 0.95rem;
                color: #1e293b;
                background-color: #f8fafc;
                transition: all 0.3s ease;
            }

                .form-select:focus {
                    outline: none;
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                    background-color: #ffffff;
                }

            .btn-submit {
                background: #10b981;
                color: white;
                border: none;
                padding: 12px 25px;
                border-radius: 8px;
                font-weight: 600;
                font-size: 1rem;
                cursor: pointer;
                transition: background 0.3s ease;
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }

                .btn-submit:hover {
                    background: #059669;
                }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
                margin-bottom: 30px;
            }
    </style>
</head>

<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="layout">
        <aside class="sidebar">
            <div class="profile">
                <div class="user-info">
                    <div class="user-avatar">
                        @if (Model.NavigationInfo != null)
                        {
                            if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                            {
                                <text>@Model.NavigationInfo.FullName[0]</text>
                            }
                            else
                            {
                                <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                            }
                        }
                    </div>
                    <h4><span>@(Model.NavigationInfo?.FullName ?? "مدير النظام")</span></h4>
                </div>
            </div>

            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>
                <li><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>

                <li class="active"><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>
                <li><a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>

            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <main class="content">
            <div class="enrollment-container">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border-radius: 4px; color: #155724; background-color: #d4edda; border: 1px solid #c3e6cb;">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border-radius: 4px; color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <div class="custom-card">
                    <div class="custom-card-header">
                        <i class="fas fa-graduation-cap fa-lg"></i>
                        <h4>تحديد بيانات الفصل المراد تسجيل المواد له</h4>
                    </div>
                    <div class="custom-card-body">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border-radius: 4px; color: #721c24; background-color: #f8d7da; border: 1px solid #f5c6cb; display:none;">
                        </div>

                        <form asp-action="ManageRegisterClassSubjects" asp-controller="ITManager" method="post">

                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="stageid" class="form-label fw-bold">المرحلة الدراسية</label>
                                    <select id="stageid" name="stageid" class="form-select" required
                                            oninvalid="this.setCustomValidity('يرجى اختيار المرحلة الدراسية')"
                                            oninput="this.setCustomValidity('')">
                                        <option value="">-- اختر المرحلة --</option>
                                        @if (Model.Stages != null)
                                        {
                                            foreach (var stageObj in Model.Stages)
                                            {
                                                <option value="@stageObj.Stage.ID">@stageObj.Stage.Name</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="levelid" class="form-label fw-bold">الصف الدراسي</label>
                                    <select id="levelid" name="levelid" class="form-select" required
                                            oninvalid="this.setCustomValidity('يرجى اختيار الصف الدراسي')"
                                            oninput="this.setCustomValidity('')">
                                        <option value="">-- اختر الصف --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="classid" class="form-label fw-bold">الفصل</label>
                                    <select id="classid" name="classid" class="form-select" required
                                            oninvalid="this.setCustomValidity('يرجى اختيار الفصل')"
                                            oninput="this.setCustomValidity('')">
                                        <option value="">-- اختر الفصل --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="TermID" class="form-label fw-bold">التيرم المراد التسجيل فيه</label>
                                    <select id="TermID" name="TermID" class="form-select" required
                                            oninvalid="this.setCustomValidity('يرجى اختيار التيرم القادم')"
                                            oninput="this.setCustomValidity('')">
                                        <option value="">-- اختر التيرم --</option>
                                        @if (Model.termsData != null)
                                        {
                                            foreach (var term in Model.termsData)
                                            {
                                                <option value="@term.TermID">@term.YearName - @term.TermName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div style="text-align: left; margin-top: 20px;">
                                <button type="submit" class="btn-submit">
                                    متابعة الإجراء <i class="fas fa-arrow-left"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
            // Sidebar Toggle Logic
            const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.querySelector(".sidebar");
            const overlay = document.getElementById("sidebarOverlay");

            menuToggle.addEventListener("click", () => {
                sidebar.classList.add("active");
                overlay.classList.add("active");
                menuToggle.classList.add("hidden");
            });

            overlay.addEventListener("click", () => {
                sidebar.classList.remove("active");
                overlay.classList.remove("active");
                menuToggle.classList.remove("hidden");
            });

            // 1. Serialize the hierarchy data to JSON
            const hierarchyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Stages?.Select(s => new
            {
                    stageId = s.Stage.ID,
                    levels = s.Levels?.Select(l => new
                    {
                            levelId = l.Level.ID,
                            levelName = l.Level.Name,
                            classes = l.Classes?.Select(c => new
                            {
                                    classId = c.ID,
                                    className = c.Name
                            })
                    })
            })));

            // 2. Cascading logic using the JSON object
            document.addEventListener("DOMContentLoaded", function () {
                const stageSelect = document.getElementById('stageid');
                const levelSelect = document.getElementById('levelid');
                const classSelect = document.getElementById('classid');

                // Stage Change -> Populate Levels
                stageSelect.addEventListener('change', function () {
                    levelSelect.innerHTML = '<option value="">-- اختر الصف --</option>';
                    classSelect.innerHTML = '<option value="">-- اختر الفصل --</option>';

                    const selectedStageId = this.value;

                    if (selectedStageId && hierarchyData) {
                        const stageObj = hierarchyData.find(s => s.stageId == selectedStageId);
                        if (stageObj && stageObj.levels) {
                            stageObj.levels.forEach(level => {
                                levelSelect.innerHTML += `<option value="${level.levelId}">${level.levelName}</option>`;
                            });
                        }
                    }
                });

                // Level Change -> Populate Classes
                levelSelect.addEventListener('change', function () {
                    classSelect.innerHTML = '<option value="">-- اختر الفصل --</option>';

                    const selectedStageId = stageSelect.value;
                    const selectedLevelId = this.value;

                    if (selectedStageId && selectedLevelId && hierarchyData) {
                        const stageObj = hierarchyData.find(s => s.stageId == selectedStageId);
                        const levelObj = stageObj?.levels?.find(l => l.levelId == selectedLevelId);

                        if (levelObj && levelObj.classes) {
                            levelObj.classes.forEach(cls => {
                                classSelect.innerHTML += `<option value="${cls.classId}">${cls.className}</option>`;
                            });
                        }
                    }
                });
            });
    </script>
</body>
</html>