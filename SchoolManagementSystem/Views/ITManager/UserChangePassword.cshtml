@{
    Layout = null;
}
@using SchoolManagementSystem.ViewModel.ITManager;
@model UserChangePasswordViewModel;

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>تغيير كلمة مرور المستخدم</title>

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/ITManager/editProfile.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

    <style>
            /* Sidebar Avatar Styles */
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            /* Validation Styles */
            .text-danger {
                color: #dc3545;
                font-size: 0.85em;
                display: block;
                margin-top: 5px;
            }

            /* User Card Styles */
            .user-card {
                background-color: #f8f9fa;
                border: 1px solid #dee2e6;
                border-radius: 8px;
                padding: 20px;
                margin-bottom: 30px;
                display: flex;
                align-items: center;
                gap: 25px;
            }

            .user-card-img {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid #ccc;
            }

            .user-card-avatar-fallback {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background-color: #e9ecef;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 3rem;
                font-weight: bold;
                color: #6c757d;
                border: 3px solid #ccc;
            }

            .user-card-info p {
                margin: 8px 0;
                font-size: 16px;
                color: #333;
            }

            .user-card-info strong {
                color: #000;
                margin-left: 5px;
            }

            /* Button group styling */
            .button-group {
                display: flex;
                gap: 15px;
                margin-top: 20px;
            }

            .reset-ssn-btn {
                background-color: #6c757d;
                color: white;
                border: none;
                padding: 12px 20px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 16px;
                transition: background 0.3s;
            }

                .reset-ssn-btn:hover {
                    background-color: #5a6268;
                }
    </style>
</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="layout">

        <aside class="sidebar">

            <div class="profile">
                <div class="user-info">
                    <div class="user-avatar">
                        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo.FullName[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                        }
                    </div>
                    <h4> <span>@Model.NavigationInfo.FullName</span></h4>
                </div>
            </div>

            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>

                <li><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>
                <li><a asp-controller="ITManager" asp-action="ManageSuccess">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li class="active"><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>
                <li> <a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>

            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <main class="content">
            <div class="box">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;">
                        @TempData["ErrorMessage"]
                    </div>
                }
                <h3 class="title">بيانات المستخدم</h3>

                <!-- User Data Card -->
                <div class="user-card">
                    <div class="user-card-image-container">
                        @if (!string.IsNullOrEmpty(Model.UserData.PhotoURL))
                        {
                            <img src="/images/users/@Model.UserData.PhotoURL" alt="صورة المستخدم" class="user-card-img" />
                        }
                        else
                        {
                            <div class="user-card-avatar-fallback">
                                @Model.UserData.Name.Substring(0, 1)
                            </div>
                        }
                    </div>

                    <div class="user-card-info">
                        <p><strong>الاسم:</strong> @Model.UserData.Name</p>
                        <p><strong>رقم الهاتف:</strong> @Model.UserData.Phone</p>
                        <p><strong>تاريخ الميلاد:</strong> @Model.UserData.BirthDate.ToString("yyyy/MM/dd")</p>
                        <p><strong>العنوان:</strong> @Model.UserData.Address</p>
                    </div>
                </div>

                <h3 class="title">تعيين كلمة سر جديدة</h3>

                <form asp-controller="ITManager" asp-action="UserChangePassword" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-weight: bold;"></div>

                    <!-- Hidden field to pass SSN back to the controller -->
                    <input type="hidden" asp-for="UserData.SSN" />

                    <div class="form-group">
                        <label>كلمة السر الجديدة</label>
                        <div class="password-field">
                            <input asp-for="Password" type="password" id="Password" placeholder="ادخل كلمة السر الجديدة">
                            <span class="toggle" onclick="togglePassword('Password', this)">
                                <i class="fa-solid fa-eye-slash"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>تأكيد كلمة السر</label>
                        <div class="password-field">
                            <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" placeholder="أعد ادخال كلمة السر">
                            <span class="toggle" onclick="togglePassword('ConfirmPassword', this)">
                                <i class="fa-solid fa-eye-slash"></i>
                            </span>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="button-group">
                        <button type="submit" class="save-btn">حفظ التعديلات</button>
                        <button type="button" class="reset-ssn-btn" onclick="resetToSSN('@Model.UserData.SSN')">
                            تعيين للرقم القومي
                        </button>
                    </div>

                </form>

            </div>
        </main>

    </div>

    <script src="@Url.Content("~/js/ITManager/editProfile.js")" defer></script>
    <script>
        // Sidebar Toggle Logic
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle.addEventListener("click", () => {
        sidebar.classList.add("active");
        overlay.classList.add("active");
        menuToggle.classList.add("hidden");
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        menuToggle.classList.remove("hidden");
        });

        // Fill passwords with SSN
        function resetToSSN(ssn) {
        const passInput = document.getElementById('Password');
        const confirmInput = document.getElementById('ConfirmPassword');

        passInput.value = ssn;
        confirmInput.value = ssn;

        passInput.type = 'text';
        confirmInput.type = 'text';

        document.querySelectorAll('.toggle i').forEach(icon => {
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
        });
        }

        // Toggle Password Visibility
        function togglePassword(inputId, toggleSpan) {
        const input = document.getElementById(inputId);
        const icon = toggleSpan.querySelector("i");

        if (input.type === "password") {
        input.type = "text";
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
        } else {
        input.type = "password";
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
        }
        }
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>