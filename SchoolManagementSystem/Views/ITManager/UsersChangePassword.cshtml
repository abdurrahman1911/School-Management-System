@{
    Layout = null;
}
@using SchoolManagementSystem.ViewModel.ITManager;
@model UsersChangePasswordViewModel;

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>تعديل البيانات</title>

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/ITManager/editProfile.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

    <style>
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .text-danger {
                color: #dc3545;
                font-size: 0.85em;
                display: block;
                margin-top: 5px;
            }

            /* Adjusted to make the standard inputs look clean without the password wrapper */
            .form-group input {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 4px;
                box-sizing: border-box;
                margin-top: 5px;
            }
    </style>
</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="layout">

        <aside class="sidebar">
            <div class="profile">
                <div class="user-info">
                    <div class="user-avatar">
                        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo.FullName[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                        }
                    </div>
                    <h4> <span>@Model.NavigationInfo.FullName</span></h4>
                </div>
            </div>

            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>
                <li><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>
                <li><a asp-controller="ITManager" asp-action="ManageSuccess">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li class="active"><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>
                <li> <a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>

            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <main class="content">
            <div class="box">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <h3 class="title">المستخدم المراد تغيير كلمة السر له</h3>

                <form asp-controller="ITManager" asp-action="UsersChangePassword" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-weight: bold;"></div>

                    <div class="form-group">
                        <label>رقم الهويه</label>
                        <input asp-for="RequireInfo.SSN" type="tel" id="SSN" placeholder="ادخل رقم الهويه">
                        <span asp-validation-for="RequireInfo.SSN" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input asp-for="RequireInfo.PhoneNumber" type="tel" id="PhoneNumber" placeholder="ادخل رقم الهاتف">
                        <span asp-validation-for="RequireInfo.PhoneNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="save-btn">تم</button>

                </form>

            </div>
        </main>

    </div>

    <script src="@Url.Content("~/js/ITManager/editProfile.js")" defer></script>
    <script>
        // Removed the togglePassword function since it is no longer needed on this page

        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle.addEventListener("click", () => {
        sidebar.classList.add("active");
        overlay.classList.add("active");
        menuToggle.classList.add("hidden");
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        menuToggle.classList.remove("hidden");
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>