@model SchoolManagementSystem.ViewModel.ITManager.TeacherSubjectViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />

</head>

<body>

    <div class="page-container">

        

        <form asp-controller="ITManager"
              asp-action="AddBinding"
              method="post">
            <h1>إضافة ربط معلم بمادة</h1>

            <div class="form-group">
                <label>المعلم</label>
                <select asp-for="TeacherId" asp-items="ViewBag.Teachers" class="form-control">
                    <option value="">-- اختر المعلم --</option>
                </select>
            </div>

            <div class="form-group">
                <label>المادة</label>
                <select asp-for="SubjectId" asp-items="ViewBag.Subjects" class="form-control">
                    <option value="">-- اختر المادة --</option>
                </select>
            </div>

            <div class="form-group">
                <label>المرحلة والصف والفصل</label>
                <select asp-for="ClassId" asp-items="ViewBag.Classes" class="form-control">
                    <option value="">-- اختر الفصل --</option>
                </select>
            </div>
            <div class="form-actions">

                <a asp-controller="ITManager"
                   asp-action="SubjectsTeachersManagement">
                    إلغاء
                </a>

                <button type="submit">
                    حفظ
                </button>

            </div>

        </form>

    </div>

</body>
</html>