@{
    Layout = null;
}

@using SchoolManagementSystem.ViewModel.ITManager;
@model AddEditStudentViewModel;

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>إضافة طالب جديد</title>

    <link rel="stylesheet" href="~/css/ITManager/addandeditforms.css" />
    <link rel="stylesheet" href="~/css/ITManager/sidebar-layout.css" />
    <link rel="stylesheet" href="~/css/ITManager/res.css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
            .user-avatar {
                width: 90px;
                height: 90px;
                overflow: hidden; /* important */
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.2);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .text-danger {
                color: red;
                font-size: 0.85em;
                margin-top: 5px;
                display: block;
            }
    </style>
</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    <div class="layout">

        <aside class="sidebar">
            <div class="profile">
                <div class="user-info">
                    <div class="user-avatar">
                        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo.FullName[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                        }
                    </div>
                    <span>@Model.NavigationInfo.FullName</span>
                </div>
            </div>

            <ul class="menu">
                <li><a asp-controller="ITManager" asp-action="Home">الصفحة الرئيسية</a></li>
                <li ><a asp-controller="ITManager" asp-action="AddNewUserRole">اضافة مستخدم</a></li>
                <li class="active"><a asp-controller="ITManager" asp-action="StudentManagement">ادارة الطلاب</a></li>
                <li><a asp-controller="ITManager" asp-action="TeacherManagement">ادارة المعلمين</a></li>
                <li><a asp-controller="ITManager" asp-action="SupervisorsManagement">ادارة المشرفين</a></li>
                <li><a asp-controller="ITManager" asp-action="ManagersManagement">ادارة المديرين</a></li>
                <li><a asp-controller="ITManager" asp-action="ParentManagement">ادارة أولياء الأمور</a></li>
                <li><a asp-controller="ITManager" asp-action="ITManagersManagement">ادارة مديري تقنية المعلومات</a></li>

                <li><a asp-controller="ITManager" asp-action="SubjectsManagement">ادارة المواد الدراسية</a></li>
                <li><a asp-controller="ITManager" asp-action="SubjectsTeachersManagement">ادارة المعلمين بالمواد</a></li>
                <li><a asp-controller="ITManager" asp-action="AddSubjectforStudent">تسجيل المواد للطلاب</a></li>

                <li><a asp-controller="ITManager" asp-action="ClassesManagement">إدارة الفصول</a></li>
                <li><a asp-controller="ITManager" asp-action="SudentClassEnrollment">تسجيل الطلاب في الفصول</a></li>

                <li><a asp-controller="ITManager" asp-action="AcademicYear">إدارة السنة الدراسية </a></li>
                <li><a asp-controller="ITManager" asp-action="AcademicTerm">إدارة التيرم الدراسي </a></li>
                <li><a asp-controller="ITManager" asp-action="ManageSuccess">ترقية الطلاب للترم التالي</a></li>
                <li><a asp-controller="ITManager" asp-action="ManageRegisterClassSubjects">تسجيل مواد الفصل للترم التالي</a></li>

                <li><a asp-controller="ITManager" asp-action="UsersChangePassword">تغير كلمه المرور للمستخدمين</a></li>

                <li><a asp-controller="ITManager" asp-action="EditProfile">تعديل البيانات</a></li>
            </ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <main class="content">
            <div class="page-container">
                @if (TempData["SuccessMessage"] != null)

                {

                    <div class="alert alert-success" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;">

                        @TempData["SuccessMessage"]

                    </div>

                }



                @if (TempData["ErrorMessage"] != null)

                {

                    <div class="alert alert-danger" style="padding: 15px; margin-bottom: 20px; border: 1px solid transparent; border-radius: 4px; color: #721c24; background-color: #f8d7da; border-color: #f5c6cb;">

                        @TempData["ErrorMessage"]

                    </div>

                }
                <form asp-controller ="ITManager"
                    asp-action="AddNewStudent" 
                      enctype="multipart/form-data">

                      
                            <h1>إضافة طالب جديد</h1>
                       

                          <div asp-validation-summary="All" class="text-danger"></div>

                            <div class="form-group">
                        <label>الاسم الأول</label>
                        <input asp-for="UserInfo.FirstName" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الاسم الثاني</label>
                        <input asp-for="UserInfo.SecondName" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>الاسم الثالث</label>
                        <input asp-for="UserInfo.ThirdName" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>الاسم الأخير</label>
                        <input asp-for="UserInfo.LastName" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.LastName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الرقم القومي (SSN)</label>
                        <input asp-for="UserInfo.SSN" value="@(Model?.SSN ?? "")" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.SSN" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الجنس</label>
                            <select  asp-for= "UserInfo.Gender" class="form-control">
                                    <option value="">-- اختر الجنس --</option>
                            <option value="true">ذكر</option>
                            <option value="false">أنثى</option>
                        </select>
                        <span asp-validation-for="UserInfo.Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>تاريخ الميلاد</label>
                        <input asp-for="UserInfo.BirthDate"
                               type="date"
                               class="form-control"
                               max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="UserInfo.BirthDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الجنسية</label>
                        <input asp-for="UserInfo.Nationality" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.Nationality" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input asp-for="UserInfo.Phone" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>البريد الإلكتروني</label>
                        <input asp-for="UserInfo.Email" type="email" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>المحافظة</label>
                        <input asp-for="UserInfo.Governorate" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.Governorate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>المدينة</label>
                        <input asp-for="UserInfo.City" type="text" class="form-control" />
                        <span asp-validation-for="UserInfo.City" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>المنطقة</label>
                        <input asp-for="UserInfo.Area" type="text" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>الشارع</label>
                        <input asp-for="UserInfo.Street" type="text" class="form-control" />
                    </div>

                    <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ddd;" />
                    <h3>بيانات ولي الأمر والتسجيل</h3>

                    <div class="form-group">
                        <label>الرقم القومي لولي الأمر</label>
                        <input asp-for="StudentDataInfo.ParentSSN" value="@(Model?.ParentSSN ?? "")" type="text" class="form-control" />
                        <span asp-validation-for="StudentDataInfo.ParentSSN" class="text-danger"></span>
                    </div>


                    <div class="form-group">
                        <label>صلة القرابة</label>
                        <select asp-for="StudentDataInfo.ParentRelation" class="form-control">
                            <option value="" disabled selected>-- اختر صلة القرابة --</option>
                            <option value="أب">أب</option>
                            <option value="أم">أم</option>
                            <option value="أخ">أخ</option>
                            <option value="أخت">أخت</option>
                            <option value="جد">جد</option>
                            <option value="جدة">جدة</option>
                            <option value="عم">عم</option>
                            <option value="عمة">عمة</option>
                            <option value="خال">خال</option>
                            <option value="خالة">خالة</option>
                            <option value="زوج أم">زوج أم</option>
                            <option value="زوجة أب">زوجة أب</option>
                            <option value="أخرى">أخرى...</option>
                        </select>
                        <span asp-validation-for="StudentDataInfo.ParentRelation" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>تاريخ الانضمام</label>
                        <input asp-for="StudentDataInfo.JoinDate" type="date" class="form-control" />
                        <span asp-validation-for="StudentDataInfo.JoinDate" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>الصورة الشخصية (اختياري)</label>

                        <input asp-for="ProfileImageFile"
                               type="file"
                               class="form-control"
                               accept="image/*" />
                    </div>

                    <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ddd;" />
                    <h3>بيانات القيد الدراسي</h3>

                    <div class="form-group">
                        <label>المرحلة الدراسية</label>
                        <select id="stageSelect" asp-for="StudentEnrollmentInfo.StageID" class="form-control">
                            <option value="">-- اختر المرحلة --</option>
                            @if (Model.Stages != null)
                            {
                                foreach (var stageInfo in Model.Stages)
                                {
                                    <option value="@stageInfo.Stage.ID">@stageInfo.Stage.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="StudentEnrollmentInfo.StageID" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الصف الدراسي</label>
                        <select id="levelSelect" asp-for="StudentEnrollmentInfo.LevelID" class="form-control" disabled>
                            <option value="">-- اختر الصف --</option>
                        </select>
                        <span asp-validation-for="StudentEnrollmentInfo.LevelID" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>الفصل</label>
                        <select id="classSelect" asp-for="StudentEnrollmentInfo.ClassID" class="form-control" disabled>
                            <option value="">-- اختر الفصل --</option>
                        </select>
                        <span asp-validation-for="StudentEnrollmentInfo.ClassID" class="text-danger"></span>
                    </div>
              

                    <div class="form-actions">
                        <a asp-controller="ITManager"
                           asp-action="StudentManagement" >
                            إلغاء
                        </a>

                        <button type="submit">
                            حفظ البيانات
                        </button>
                    </div>

                </form>

            </div>
        </main>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/nationalities-ar.js"></script>

 
    <script>
        $(document).ready(function () {
        // Safe C# Projection: Bypasses the anonymous type casting error by returning null when lists are missing
        var schoolData = @Html.Raw(Json.Serialize(Model.Stages?.Select(s => new
        {
            stageId = s.Stage != null ? s.Stage.ID : 0,
            stageName = s.Stage != null ? s.Stage.Name : "",
            levels = s.Levels != null ? s.Levels.Select(l => new
            {
                levelId = l.Level != null ? l.Level.ID : 0,
                levelName = l.Level != null ? l.Level.Name : "",
                classes = l.Classes != null ? l.Classes.Select(c => new
                {
                    classId = c.ID,
                    className = c.Name
                }).ToList() : null
            }).ToList() : null
        })));

        var $stageSelect = $('#stageSelect');
        var $levelSelect = $('#levelSelect');
        var $classSelect = $('#classSelect');

        // Extract pre-selected values from the Model for Edit Mode
        var preSelectedStageId = '@(Model.StudentEnrollmentInfo?.StageID ?? 0)';
        var preSelectedLevelId = '@(Model.StudentEnrollmentInfo?.LevelID ?? 0)';
        var preSelectedClassId = '@(Model.StudentEnrollmentInfo?.ClassID ?? 0)';

        // Modified to accept a selected value
        function populateLevels(stageId, selectedLevelId = null) {
        $levelSelect.empty().append('<option value="">-- اختر الصف --</option>').prop('disabled', true);
        $classSelect.empty().append('<option value="">-- اختر الفصل --</option>').prop('disabled', true);

        if (!stageId) return;

        var selectedStage = schoolData.find(s => s.stageId == stageId);

        if (selectedStage && selectedStage.levels && selectedStage.levels.length > 0) {
        $.each(selectedStage.levels, function (i, lvl) {
        $levelSelect.append('<option value="' + lvl.levelId + '">' + lvl.levelName + '</option>');
        });
        $levelSelect.prop('disabled', false);

        // If we are in Edit Mode, select the existing Level
        if (selectedLevelId && selectedLevelId != '0') {
        $levelSelect.val(selectedLevelId);
        }
        }
        }

        // Modified to accept a selected value
        function populateClasses(stageId, levelId, selectedClassId = null) {
        $classSelect.empty().append('<option value="">-- اختر الفصل --</option>').prop('disabled', true);

        if (!stageId || !levelId) return;

        var selectedStage = schoolData.find(s => s.stageId == stageId);
        if (selectedStage) {
        var selectedLevel = selectedStage.levels.find(l => l.levelId == levelId);

        if (selectedLevel && selectedLevel.classes && selectedLevel.classes.length > 0) {
        $.each(selectedLevel.classes, function (i, cls) {
        $classSelect.append('<option value="' + cls.classId + '">' + cls.className + '</option>');
        });
        $classSelect.prop('disabled', false);

        // If we are in Edit Mode, select the existing Class
        if (selectedClassId && selectedClassId != '0') {
        $classSelect.val(selectedClassId);
        }
        }
        }
        }

        // 1. Event Listeners for UI interaction
        $stageSelect.change(function () {
        populateLevels($(this).val());
        });

        $levelSelect.change(function () {
        populateClasses($stageSelect.val(), $(this).val());
        });

        // 2. Initialization Logic for Edit Mode
        // If the page loads and a StageID already exists, trigger the population manually
        if (preSelectedStageId && preSelectedStageId != '0') {

        // Populate Levels and select the current Level
        populateLevels(preSelectedStageId, preSelectedLevelId);

        // If a Level was selected, populate Classes and select the current Class
        if (preSelectedLevelId && preSelectedLevelId != '0') {
        populateClasses(preSelectedStageId, preSelectedLevelId, preSelectedClassId);
        }
        }
        });

        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle.addEventListener("click", () => {
        sidebar.classList.add("active");
        overlay.classList.add("active");
        menuToggle.classList.add("hidden"); // اخفاء الزر
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        menuToggle.classList.remove("hidden"); // اظهار الزر
        });

    </script>

   
</body>
</html>