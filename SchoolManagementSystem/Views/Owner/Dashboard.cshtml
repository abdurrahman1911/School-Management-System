@using SchoolManagementSystem.ViewModel.Owner
@model OwnerDashboardViewModel
@{
    ViewData["Title"] = "الصفحة الرئيسية";
}



<!DOCTYPE html>
<html lang="ar" dir="rtl">

   
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/Admin/dashboard.css"/>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/Admin/res.css" />

    <style>
            .user-info {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .sidebar .logo {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.2);
                text-align: center;
            }

            .user-avatar {
                width: 70px;
                height: 70px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info span {
                font-size: 16px;
                font-weight: 600;
                text-align: center;
            }
    </style>
   
</head>
<body>

    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <!-- Side navigation bar -->
  <aside class="sidebar">    
        <div class="logo">
           <div class="user-info">
                <div class="user-avatar">
                    @if (string.IsNullOrEmpty(Model.NavigationViewModel.ProfilePhotoUrl))
                    {
                        <text>@Model.NavigationViewModel.FullName[0]</text>
                    }
                    else
                    {
                       <img src="/images/users/@Model.NavigationViewModel.ProfilePhotoUrl" alt="Profile Photo" />
                    }
                </div>
                <span>@Model.FullName</span>
            </div>
        </div>
        
       <ul class="nav-links">
    <li><a asp-controller="Owner" asp-action="Dashboard" class="active">الصفحة الرئيسية</a></li>
        <li><a asp-controller="Owner" asp-action="notes">الملاحظات</a></li>
            <li><a asp-controller="Owner" asp-action="Notifications">الإشعارات</a></li>

            <li><a asp-controller="Owner" asp-action="Successandfailure">النجاح والرسوب</a></li>
            <li><a asp-controller="Owner" asp-action="Student">الطلاب</a></li>
            <li><a asp-controller="Owner" asp-action="Teachers">المعلمين</a></li>
            <li><a asp-controller="Owner" asp-action="Supervisors">المشرفين</a></li>
            <li><a asp-controller="Owner" asp-action="Editdata">تعديل البيانات</a></li>
</ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>
    <!-- Main content area -->
    <div class="main-content" id="mainContent">
        <div class="page active" id="home">
            <div class="content-header">
                <h1><i class="fas fa-home"></i> الصفحة الرئيسية</h1>
            </div>

            <!-- Teacher information card -->
            <div class="teacher-card-simple">
                
                    <div class="card-header-simple">
                    <div class="school-logo">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div class="school-title">
                        <h2>مدرسة الأوائل</h2>
                        
                    </div>
                </div>
                <div class="card-content-simple">
                    <div class="teacher-info-main">
                        <div class="teacher-name">
                          <h3>@Model.FullName</h3>
                        </div>
                        
                        <div class="teacher-details">
                            <div class="detail-row">
                                <i class="fas fa-envelope"></i>
                                <div class="detail-content">
                                    <span class="detail-label">البريد الإلكتروني:</span>
                                    <span class="detail-value">@Model.Email</span>
                                </div>
                            </div>
                            
                            <div class="detail-row">
                                <i class="fas fa-phone"></i>
                                <div class="detail-content">
                                    <span class="detail-label">رقم الهاتف:</span>
                                    <span class="detail-value">@Model.PhoneNumber</span>
                                </div>
                            </div>
                            
                            <div class="detail-row">
                                <i class="fas fa-school"></i>
                                <div class="detail-content">
                                    <span class="detail-label">المدرسة:</span>
                                    <span class="detail-value">مدرسة الأوائل الأهلية</span>
                                </div>
                            </div>
                            
                            <div class="detail-row">
                                <i class="fas fa-calendar-alt"></i>
                                <div class="detail-content">
                                    <span class="detail-label">تاريخ الانضمام:</span>
                                    <span class="detail-value">@Model.AddedDate.ToString("yyyy / MM / dd")</span>
                                </div>
                            </div>
                            
                        
                            
                          
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <script>
                 const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.querySelector(".sidebar");
            const overlay = document.getElementById("sidebarOverlay");

            menuToggle.addEventListener("click", () => {
            sidebar.classList.add("active");
            overlay.classList.add("active");
            menuToggle.classList.add("hidden"); // اخفاء الزر
            });

            overlay.addEventListener("click", () => {
            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            menuToggle.classList.remove("hidden"); // اظهار الزر
            });
    </script>
</body>
</html>