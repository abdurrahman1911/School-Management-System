@using SchoolManagementSystem.ViewModel.Owner
@model OwnerNotificationsViewModel

@{
    ViewData["Title"] = "الإشعارات";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">


<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Admin/Notifications.css" />
    <link rel="stylesheet" href="~/css/Admin/res.css" />
    <style>
            .user-info {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .sidebar .logo {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.2);
                text-align: center;
            }

            .user-avatar {
                width: 70px;
                height: 70px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info span {
                font-size: 16px;
                font-weight: 600;
                text-align: center;
            }
    </style>
</head>


<body>


    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>


    <div class="sidebar-overlay" id="sidebarOverlay"></div>



    <aside class="sidebar">


        <div class="logo">

            <div class="user-info">


                <div class="user-avatar">

                    @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                    {
                        <text>@Model.NavigationInfo.FullName[0]</text>
                    }
                    else
                    {
                        <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" />
                    }

                </div>


                <span>
                    @Model.NavigationInfo.FullName
                </span>


            </div>

        </div>



        <ul class="nav-links">


            <li>
                <a asp-controller="Owner" asp-action="Dashboard">
                    الصفحة الرئيسية
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Notes">
                    الملاحظات
                </a>
            </li>



            <li>
                <a asp-controller="Owner" asp-action="Notifications" class="active">
                    الإشعارات
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Successandfailure">
                    النجاح والرسوب
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Student">
                    الطلاب
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Teachers">
                    المعلمين
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Supervisors">
                    المشرفين
                </a>
            </li>


            <li>
                <a asp-controller="Owner" asp-action="Editdata">
                    تعديل البيانات
                </a>
            </li>


        </ul>



        <a asp-controller="Home"
           asp-action="Index"
           class="logout">

            تسجيل الخروج

        </a>


    </aside>




    <main class="main-content">


        <div class="box">


            <h1 class="content-header">
                سجل العمليات والإشعارات
            </h1>




            @if (Model.Logs == null || Model.Logs.Count == 0)
            {

                <div class="empty-state">

                    <h3>
                        لا توجد إشعارات أو عمليات مسجلة حتى الآن.
                    </h3>

                </div>

            }

            else
            {


                <div class="table-wrapper">


                    <table class="notifications-table">


                        <thead>

                            <tr>

                                <th>
                                    الموظف المسؤول
                                </th>


                                <th>
                                    نوع الإجراء
                                </th>


                                <th>
                                    التفاصيل
                                </th>


                                <th>
                                    التاريخ والوقت
                                </th>


                            </tr>


                        </thead>



                        <tbody>


                            @foreach (var log in Model.Logs)
                            {

                                <tr>


                                    <td>
                                        @log.ActorName
                                    </td>


                                    <td>
                                        @log.Action
                                    </td>


                                    <td>
                                        @log.Details
                                    </td>


                                    <td dir="ltr">
                                        @log.LogDate.ToString("yyyy/MM/dd hh:mm tt")
                                    </td>


                                </tr>

                            }


                        </tbody>



                    </table>


                </div>




                @if (Model.TotalPages > 1)
                {


                    <div class="pagination-container">


                        <a class="page-btn @(Model.HasPreviousPage ? "" : "disabled")"
                           asp-action="Notifications"
                           asp-route-page="@(Model.CurrentPage - 1)">

                            السابق

                        </a>



                        <span class="page-info">

                            صفحة @Model.CurrentPage من @Model.TotalPages

                        </span>




                        <a class="page-btn @(Model.HasNextPage ? "" : "disabled")"
                           asp-action="Notifications"
                           asp-route-page="@(Model.CurrentPage + 1)">

                            التالي

                        </a>



                    </div>


                }



            }



        </div>


    </main>




    <script>


            const menuToggle =
            document.getElementById("menuToggle");


            const sidebar =
            document.querySelector(".sidebar");


            const overlay =
            document.getElementById("sidebarOverlay");



            menuToggle.onclick = ()=>{

            sidebar.classList.add("active");
            overlay.classList.add("active");
            menuToggle.classList.add("hidden");

            }



            overlay.onclick = ()=>{

            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            menuToggle.classList.remove("hidden");

            }



    </script>


</body>

</html>