@using System.Globalization
@using Newtonsoft.Json
@using SchoolManagementSystem.ViewModel.Owner
@model  OwnerTeacherSubjectsViewModel
@{
    ViewData["Title"] = "مواد المدرس";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
       
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>قائمة الطلاب</title>
    <link rel="stylesheet" href="~/css/Admin/students.css" />

    <style>
            .user-info {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .sidebar .logo {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.2);
                text-align: center;
            }

            .user-avatar {
                width: 70px;
                height: 70px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info span {
                font-size: 16px;
                font-weight: 600;
                text-align: center;
            }
    </style>
</head>
<body>
    <!-- sidebar-->
    <aside class="sidebar">

        <div class="logo">
            <div class="user-info">
    <div class="user-avatar">
        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
        {
            <text>@Model.NavigationInfo.FullName[0]</text>
        }
        else
        {
           <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
        }
    </div>
    <span>@Model.NavigationInfo.FullName</span>
</div>
        </div>

        <ul class="nav-links">
            <li><a asp-controller="Owner" asp-action="Dashboard">الصفحة الرئيسية</a></li>
            <li><a asp-controller="Owner" asp-action="notes">الملاحظات</a></li>
            <li><a asp-controller="Owner" asp-action="Notifications">الإشعارات</a></li>

            <li><a asp-controller="Owner" asp-action="Successandfailure">النجاح والرسوب</a></li>
            <li><a asp-controller="Owner" asp-action="Student" >الطلاب</a></li>
            <li><a asp-controller="Owner" asp-action="Teachers">المعلمين</a></li>
            <li><a asp-controller="Owner" asp-action="Supervisors">المشرفين</a></li>
            <li><a asp-controller="Owner" asp-action="Editdata">تعديل البيانات</a></li>
        </ul>
        <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
    </aside>
    <main class="main-content">
        <header class="content-header">
            <h1>@Model.TeacherSubjects.FullName</h1>
            <h1>@Model.TeacherSubjects.Subjects.Count : مواد المدرس</h1>
            <div class="header-info">
            </div>
        </header>

        <div class="content-body">

            

        
            <div class="students-table">
                @if (Model.TeacherSubjects.Subjects.Count == 0)
                {

                    <div class="empty-state">
                        <div class="empty-icon">📚</div>
                        <h2>لا يوجد مواد لعرضها</h2>
                    </div>

                }
                else
                {
                    <table class="table table-hover table-striped table-bordered ">

                        <thead>
                            <tr>
                                <th>اسم المادة</th>
                                <th>كود المادة</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var subject in Model.TeacherSubjects.Subjects)
                            {
                                <tr>
                                   <td>@subject.Name</td>
                                   <td>@subject.Code</td>
                                </tr>
                            }
                        </tbody>

                    
                    </table>
                }
            </div>
        </div>
    </main>

   
</body>
</html>