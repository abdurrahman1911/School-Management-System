@{
    ViewData["Title"] = "قائمة المشرفين";
}
@using SchoolManagementSystem.ViewModel.Owner
@model OwnerSupervisorsViewModel

<!DOCTYPE html>
<html lang="ar" dir="rtl">

        
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>قائمة المشرفين</title>
    <link rel="stylesheet" href="~/css/Admin/supervisors.css" />
    <link rel="stylesheet" href="~/css/Admin/res.css" />
    <style>
            .user-info {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .sidebar .logo {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.2);
                text-align: center;
            }

            .user-avatar {
                width: 70px;
                height: 70px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info span {
                font-size: 16px;
                font-weight: 600;
                text-align: center;
            }
    </style>

</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <aside class="sidebar">
        <div class="logo">
            <div class="user-info">
    <div class="user-avatar">
        @if (string.IsNullOrEmpty(Model.NavigationData.ProfilePhotoUrl))
        {
            <text>@Model.NavigationData.FullName[0]</text>
        }
        else
        {
           <img src="/images/users/@Model.NavigationData.ProfilePhotoUrl" alt="Profile Photo" />
        }
    </div>
    <span>@Model.NavigationData.FullName</span>
</div>
        </div>

        <ul class="nav-links">
            <li><a asp-controller="Owner" asp-action="Dashboard">الصفحة الرئيسية</a></li>
            <li><a asp-controller="Owner" asp-action="notes">الملاحظات</a></li>
            <li><a asp-controller="Owner" asp-action="Notifications">الإشعارات</a></li>

            <li><a asp-controller="Owner" asp-action="Successandfailure">النجاح والرسوب</a></li>
            <li><a asp-controller="Owner" asp-action="Student">الطلاب</a></li>
            <li><a asp-controller="Owner" asp-action="Teachers">المعلمين</a></li>
            <li><a asp-controller="Owner" asp-action="Supervisors" class="active">المشرفين</a></li>
            <li><a asp-controller="Owner" asp-action="Editdata">تعديل البيانات</a></li>
        </ul>
        <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
    </aside>
    <main class="main-content">
        <header class="content-header">
            <h1><i class="fas fa-chalkboard-user"></i> قائمة المشرفين</h1>
        </header>

        <div class="content-body">
            <!-- Supervisors Table -->
            <div class="table-section">
                 @if (Model.SchoolSupervisors.Count == 0)
                {

                    <div class="empty-state">
                        <div class="empty-icon">📚</div>
                        <h2>لا يوجد مشرفين لعرضهم</h2>
                        
                    </div>

                }
                else
                {
                <table id="supervisorsTable">
                    <thead>
                        <tr>
                            <th>اسم المشرف/ة</th>
                            <th>ايام الغياب</th>
                            <th>تاريخ التعيين</th>
                            <th>تاريخ ترك العمل</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="supervisorsTableBody">
                        @foreach(var supervisor in Model.SchoolSupervisors)
                        {
                            <tr>
                                <td>@supervisor.FullName</td>
                                <td>@supervisor.AbcenseCount</td>
                                <td>@supervisor.HireDate.ToString("yyyy-MM-dd")</td>
                                <td>@(supervisor.ExiteDate != null ? supervisor.ExiteDate.Value.ToString("yyyy-MM-dd") : "مستمر بالعمل")</td>
                                <td>
                                        <a asp-controller="Owner" asp-action="UserDetails" asp-route-UserID="@supervisor.UserID" class=" btn btn-primary">البيانات</a>
                                        <a asp-controller="Owner" asp-action="UserAbcense" asp-route-UserID="@supervisor.UserID" class=" btn btn-danger">الغياب</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                }
            </div>

        </div>
    </main>

  

    <script>
               const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.querySelector(".sidebar");
            const overlay = document.getElementById("sidebarOverlay");

            menuToggle.addEventListener("click", () => {
            sidebar.classList.add("active");
            overlay.classList.add("active");
            menuToggle.classList.add("hidden"); // اخفاء الزر
            });

            overlay.addEventListener("click", () => {
            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            menuToggle.classList.remove("hidden"); // اظهار الزر
            });
    </script>


</body>
</html>