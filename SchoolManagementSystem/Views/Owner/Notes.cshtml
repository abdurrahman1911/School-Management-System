@using SchoolManagementSystem.ViewModel.Owner
@model OwnerNotesViewModel

@{
    ViewData["Title"] = "الملاحظات";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

       

<head>
    <meta charset="UTF-8">
    <title>الملاحظات</title>

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Admin/Notes.css" />
    <link rel="stylesheet" href="~/css/Admin/res.css" />
    <style>
            .user-info {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

            .sidebar .logo {
                padding: 25px 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.2);
                text-align: center;
            }

            .user-avatar {
                width: 70px;
                height: 70px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: bold;
                border: 2px solid rgba(255, 255, 255, 0.3);
                overflow: hidden;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .user-info span {
                font-size: 16px;
                font-weight: 600;
                text-align: center;
            }
    </style>
</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>


    <aside class="sidebar">
        <div class="logo">
           <div class="user-info">
    <div class="user-avatar">
        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
        {
            <text>@Model.NavigationInfo.FullName[0]</text>
        }
        else
        {
           <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
        }
    </div>
    <span>@Model.NavigationInfo.FullName</span>
</div>
        </div>

        <ul class="nav-links">
            <li><a asp-controller="Owner" asp-action="Dashboard">الصفحة الرئيسية</a></li>
            <li><a asp-controller="Owner" asp-action="Notes" class="active">الملاحظات</a></li>
            <li><a asp-controller="Owner" asp-action="Notifications">الإشعارات</a></li>

            <li><a asp-controller="Owner" asp-action="Successandfailure">النجاح والرسوب</a></li>
            <li><a asp-controller="Owner" asp-action="Student">الطلاب</a></li>
            <li><a asp-controller="Owner" asp-action="Teachers">المعلمين</a></li>
            <li><a asp-controller="Owner" asp-action="Supervisors">المشرفين</a></li>
            <li><a asp-controller="Owner" asp-action="Editdata">تعديل البيانات</a></li>
        </ul>
        <a asp-controller="Home" asp-action="Index" class="logout">
            تسجيل الخروج
        </a>
    </aside>

    <main class="main-content">
        <div class="box">
            <h1 class="content-header">
                الملاحظات
            </h1>

            <div class="notes-tabs">
                <button class="tab-btn active" data-target="students">الطلاب</button>
                <button class="tab-btn" data-target="teachers">المعلمين</button>
                <button class="tab-btn" data-target="supervisors">المشرفين</button>
            </div>

            <div class="tab-content" >
                 
                <div class="tab-panel active" id="students" >
                    
                    @if (Model.OwnerNotesInfo.StudentsNotes.Count == 0)
                    {
                        <div class="notes-box empty-state">
                            <h3>لا توجد ملاحظات حالياً</h3>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">

                        <table class="notes-table">
                            <thead>
                                <tr>
                                    <th>اسم الطالب\ة</th>
                                    <th>الملاحظة</th>
                                    <th>التاريخ</th>
                                    <th>الكاتب للملاحظة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var Note in Model.OwnerNotesInfo.StudentsNotes)
                                {
                                    <tr>
                                        <td>@Note.TargetName</td>
                                        <td>@Note.Detail</td>
                                        <td>@Note.Date.ToString("yyyy/MM/dd")</td>
                                        <td>@Note.WriterName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                </div>

                <div class="tab-panel" id="teachers">
                    @if (Model.OwnerNotesInfo.TeachersNotes.Count == 0)
                    {
                        <div class="notes-box empty-state">
                            <h3>لا توجد ملاحظات حالياً</h3>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">

                        <table class="notes-table">
                            <thead>
                                <tr>
                                    <th>اسم المعلم\ة</th>
                                    <th>الملاحظة</th>
                                    <th>التاريخ</th>
                                    <th>الكاتب للملاحظة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var Note in Model.OwnerNotesInfo.TeachersNotes)
                                {
                                    <tr>
                                        <td>@Note.TargetName</td>
                                        <td>@Note.Detail</td>
                                        <td>@Note.Date.ToString("yyyy/MM/dd")</td>
                                        <td>@Note.WriterName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                </div>

                <div class="tab-panel" id="supervisors">
                    @if (Model.OwnerNotesInfo.SupervisorsNotes.Count == 0)
                    {
                        <div class="notes-box empty-state">
                            <h3>لا توجد ملاحظات حالياً</h3>
                        </div>
                    }
                    else
                    {
                        <div class="table-wrapper">

                        <table class="notes-table">
                            <thead>
                                <tr>
                                    <th>اسم المشرف\ة</th>
                                    <th>الملاحظة</th>
                                    <th>التاريخ</th>
                                    <th>الكاتب للملاحظة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var Note in Model.OwnerNotesInfo.SupervisorsNotes)
                                {
                                    <tr>
                                        <td>@Note.TargetName</td>
                                        <td>@Note.Detail</td>
                                        <td>@Note.Date.ToString("yyyy/MM/dd")</td>
                                        <td>@Note.WriterName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </main>

    <script>
            // Tab switching logic
            const tabs = document.querySelectorAll(".tab-btn");
            const panels = document.querySelectorAll(".tab-panel");

            tabs.forEach(tab => {
                tab.addEventListener("click", () => {
                    // 1. Remove 'active' class from all tabs and panels
                    tabs.forEach(t => t.classList.remove("active"));
                    panels.forEach(p => p.classList.remove("active"));

                    // 2. Add 'active' class to the clicked tab
                    tab.classList.add("active");

                    // 3. Find the target panel using the 'data-target' attribute and show it
                    const targetId = tab.getAttribute("data-target");
                    document.getElementById(targetId).classList.add("active");
                });
            });

                    const menuToggle = document.getElementById("menuToggle");
            const sidebar = document.querySelector(".sidebar");
            const overlay = document.getElementById("sidebarOverlay");

            menuToggle.addEventListener("click", () => {
            sidebar.classList.add("active");
            overlay.classList.add("active");
            menuToggle.classList.add("hidden"); // اخفاء الزر
            });

            overlay.addEventListener("click", () => {
            sidebar.classList.remove("active");
            overlay.classList.remove("active");
            menuToggle.classList.remove("hidden"); // اظهار الزر
            });
    </script>
</body>
</html>