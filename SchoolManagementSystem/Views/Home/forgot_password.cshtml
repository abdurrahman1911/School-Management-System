@using SchoolManagementSystem.ViewModel
@model ForgotPasswordViewModel
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>استعادة كلمة المرور - مدارس الأوائل الأهلية</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/Main/login.css")">
    
    <style>
        .contact-box {
            text-align: center;
            padding: 30px;
            background: #f9f9f9;
            border-radius: 15px;
            border: 1px solid #eee;
        }
        .contact-box i {
            font-size: 50px;
            color: #2c3e50;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>
    <div class="background"></div>
    <div class="overlay"></div>

    <div class="login-container">
        <div class="logo-section">
            <img src="@Url.Content("~/images/logo.png")" alt="School Logo" class="school-logo">
            <h1 class="school-name">مدارس الأوائل الأهلية</h1>
            <p class="school-subtitle">AL-AWAEL SCHOOLS</p>
        </div>

        <div class="login-card">
            <h2 class="login-title">استعادة كلمة المرور</h2>
            
            <div class="contact-box">
                <i class="fas fa-headset"></i>
                <p style="font-size: 1.2rem; font-weight: bold; color: #333;">
                    لإعادة تعيين كلمة المرور الخاصة بك، يرجى التوجه إلى إدارة المدرسة أو التواصل مع الدعم الفني.
                </p>
            </div>

            <!-- Back Link -->
            <div class="back-link" style="margin-top: 20px; text-align: center;">
                <a asp-controller="Home" asp-action="Login">
                    <i class="fas fa-arrow-right"></i>
                    العودة لتسجيل الدخول
                </a>
            </div>
        </div>
    </div>
</body>
</html>