@using SchoolManagementSystem.ViewModel
@model ResetPasswordViewModel
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تعيين كلمة المرور الجديدة - مدارس الأوائل الأهلية</title>
    <meta name="description" content="تعيين كلمة المرور الجديدة لنظام مدارس الأوائل الأهلية">
    <!-- Fonts and icons Used -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/Main/login.css")">
</head>

<body>
    <!-- Background -->
    <div class="background"></div>
    <div class="overlay"></div>

    <!-- Floating Shapes -->
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Container -->
    <div class="login-container">
        <!-- Logo Section -->
        <div class="logo-section">
            <img src="@Url.Content("~/images/logo.png")" alt="School Logo" class="school-logo">
            <h1 class="school-name">مدارس الأوائل الأهلية</h1>
            <p class="school-subtitle">AL-AWAEL SCHOOLS</p>
        </div>

        <!-- Card -->
        <div class="login-card">
            <!-- Stepper -->
            <div class="stepper">
                <div class="stepper-step completed">
                    <div class="stepper-circle">
                        <i class="fas fa-check"></i>
                    </div>
                    <span class="stepper-label">التحقق من الهوية</span>
                </div>
                <div class="stepper-line active"></div>
                <div class="stepper-step active">
                    <div class="stepper-circle">
                        <i class="fas fa-key"></i>
                    </div>
                    <span class="stepper-label">كلمة مرور جديدة</span>
                </div>
            </div>

            <h2 class="login-title">تعيين كلمة المرور</h2>
            <p class="form-description">
                تم التحقق من هويتك بنجاح! الرجاء إدخال كلمة المرور الجديدة
            </p>

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-error" style="display:none;"></div>

            <!-- Form -->
            <form id="resetPasswordForm" method="post" asp-action="ResetPassword" asp-controller="Home">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />

                <!-- New Password -->
                <div class="form-group">
                    <label class="form-label" for="newPassword">كلمة المرور الجديدة</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="NewPassword" type="password" class="form-input" id="newPassword"
                            placeholder="أدخل كلمة المرور الجديدة" required>
                        <i class="fas fa-eye-slash toggle-password" id="toggleNewPassword"></i>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                    <!-- Password Strength Meter -->
                    <div class="password-strength" id="passwordStrength" style="display:none;">
                        <div class="strength-bars">
                            <div class="strength-bar" id="bar1"></div>
                            <div class="strength-bar" id="bar2"></div>
                            <div class="strength-bar" id="bar3"></div>
                            <div class="strength-bar" id="bar4"></div>
                        </div>
                        <span class="strength-text" id="strengthText"></span>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group">
                    <label class="form-label" for="confirmPassword">تأكيد كلمة المرور</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="ConfirmPassword" type="password" class="form-input" id="confirmPassword"
                            placeholder="أعد إدخال كلمة المرور" required>
                        <i class="fas fa-eye-slash toggle-password" id="toggleConfirmPassword"></i>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    <!-- Password Match Indicator -->
                    <div class="password-match" id="passwordMatch" style="display:none;">
                        <i class="fas fa-check-circle"></i>
                        <span>كلمتا المرور متطابقتان</span>
                    </div>
                    <div class="password-mismatch" id="passwordMismatch" style="display:none;">
                        <i class="fas fa-times-circle"></i>
                        <span>كلمتا المرور غير متطابقتين</span>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="submit-btn" id="resetSubmitBtn">
                    <span class="btn-text">حفظ كلمة المرور</span>
                    <i class="fas fa-check-circle btn-icon"></i>
                    <div class="btn-loader" style="display:none;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                </button>

                <!-- Back Link -->
                <div class="back-link">
                    <a asp-controller="Home" asp-action="Login">
                        <i class="fas fa-arrow-right"></i>
                        العودة لتسجيل الدخول
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="@Url.Content("~/js/Main/main.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>

</html>