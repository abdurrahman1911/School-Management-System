@using SchoolManagementSystem.ViewModel.Student
@model ExamReviewViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مراجعة الاختبار - @Model.ExamName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 32px 16px;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.08) 0%, transparent 50%);
            z-index: 0;
        }

        .review-wrapper {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }

        /* ── Header Card ── */
        .review-header {
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 40px 36px;
            margin-bottom: 28px;
            animation: fadeInUp 0.5s ease both;
        }

        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 28px;
        }

        .header-info h1 {
            font-size: 24px;
            font-weight: 800;
            color: #f1f5f9;
            margin-bottom: 8px;
        }

        .header-badges {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #94a3b8;
        }

        /* Score mini circle in header */
        .header-score {
            text-align: center;
        }

        .score-mini-circle {
            position: relative;
            width: 110px;
            height: 110px;
        }

        .score-mini-bg { fill: none; stroke: rgba(255, 255, 255, 0.06); stroke-width: 8; }
        .score-mini-fill {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: center;
            transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .score-mini-text {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .score-mini-pct {
            font-family: 'Inter', sans-serif;
            font-size: 26px;
            font-weight: 800;
            line-height: 1;
        }

        .score-mini-label {
            font-size: 11px;
            color: #94a3b8;
            font-weight: 600;
        }

        /* Stats row */
        .header-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 12px;
        }

        .stat-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            padding: 16px;
            text-align: center;
        }

        .stat-val {
            font-family: 'Inter', sans-serif;
            font-size: 22px;
            font-weight: 800;
        }

        .stat-lbl {
            font-size: 12px;
            color: #94a3b8;
            font-weight: 600;
            margin-top: 2px;
        }

        /* ── Questions List ── */
        .questions-section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: fadeInUp 0.5s ease 0.15s both;
        }

        .question-card {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            margin-bottom: 20px;
            overflow: hidden;
            animation: fadeInUp 0.5s ease both;
            transition: border-color 0.3s ease;
        }

        .question-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
        }

        .question-card.correct {
            border-right: 4px solid #10b981;
        }

        .question-card.wrong {
            border-right: 4px solid #ef4444;
        }

        .q-header {
            padding: 20px 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .q-number-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            font-size: 14px;
            flex-shrink: 0;
        }

        .question-card.correct .q-number-badge {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }

        .question-card.wrong .q-number-badge {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .q-title {
            font-size: 16px;
            font-weight: 700;
            color: #e2e8f0;
            line-height: 1.6;
            flex: 1;
        }

        .q-degree {
            font-size: 13px;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 8px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .question-card.correct .q-degree {
            background: rgba(16, 185, 129, 0.1);
            color: #34d399;
        }

        .question-card.wrong .q-degree {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }

        /* Answers */
        .q-answers {
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .answer-row {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(255, 255, 255, 0.02);
            transition: all 0.3s ease;
            font-size: 15px;
            font-weight: 500;
            color: #94a3b8;
        }

        .answer-row.is-correct {
            background: rgba(16, 185, 129, 0.1);
            border-color: rgba(16, 185, 129, 0.3);
            color: #34d399;
        }

        .answer-row.is-student-wrong {
            background: rgba(239, 68, 68, 0.08);
            border-color: rgba(239, 68, 68, 0.25);
            color: #f87171;
        }

        .answer-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            flex-shrink: 0;
            font-size: 14px;
        }

        .answer-row.is-correct .answer-icon {
            background: rgba(16, 185, 129, 0.2);
        }

        .answer-row.is-student-wrong .answer-icon {
            background: rgba(239, 68, 68, 0.2);
        }

        .answer-row:not(.is-correct):not(.is-student-wrong) .answer-icon {
            background: rgba(255, 255, 255, 0.05);
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin: 0 9px;
        }

        .answer-text {
            flex: 1;
            line-height: 1.5;
        }

        .answer-tag {
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 6px;
            white-space: nowrap;
        }

        .tag-correct {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }

        .tag-your-answer {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .tag-your-correct {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }

        /* ── Footer ── */
        .review-footer {
            text-align: center;
            margin-top: 8px;
            animation: fadeInUp 0.5s ease 0.3s both;
        }

        .btn-back-tests {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 40px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            font-family: 'Cairo', sans-serif;
            font-size: 16px;
            font-weight: 700;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
        }

        .btn-back-tests:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(59, 130, 246, 0.4);
            color: white;
        }

        /* Colors */
        .clr-green { color: #10b981; }
        .clr-blue { color: #3b82f6; }
        .clr-red { color: #ef4444; }
        .clr-purple { color: #8b5cf6; }

        /* Animations */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Responsive */
        @@media (max-width: 600px) {
            body { padding: 16px 10px; }
            .review-header { padding: 24px 18px; }
            .header-top { flex-direction: column; align-items: center; text-align: center; }
            .header-info h1 { font-size: 20px; }
            .q-header { flex-wrap: wrap; }
            .q-answers { padding: 16px; }
        }
    </style>
</head>

<body>
    @{
        string gradeColor = "clr-blue";
        if (Model.Percentage >= 85) gradeColor = "clr-green";
        else if (Model.Percentage < 60) gradeColor = "clr-red";

        double radius = 45;
        double circumference = 2 * Math.PI * radius;
        double offset = circumference - ((double)Model.Percentage / 100.0 * circumference);

        string strokeColor = "#3b82f6";
        if (Model.Percentage >= 85) strokeColor = "#10b981";
        else if (Model.Percentage < 60) strokeColor = "#ef4444";
    }

    <div class="review-wrapper">
        <!-- Header -->
        <div class="review-header">
            <div class="header-top">
                <div class="header-info">
                    <h1>📋 مراجعة: @Model.ExamName</h1>
                    <div class="header-badges">
                        <span class="badge">📚 @Model.SubjectName</span>
                        <span class="badge">📅 @Model.ExamDate</span>
                    </div>
                </div>
                <div class="header-score">
                    <div class="score-mini-circle">
                        <svg width="110" height="110" viewBox="0 0 110 110">
                            <circle class="score-mini-bg" cx="55" cy="55" r="@radius" />
                            <circle class="score-mini-fill" cx="55" cy="55" r="@radius"
                                    stroke="@strokeColor"
                                    stroke-dasharray="@circumference"
                                    stroke-dashoffset="@circumference"
                                    id="scoreCircle"
                                    data-target="@offset" />
                        </svg>
                        <div class="score-mini-text">
                            <div class="score-mini-pct @gradeColor">@Model.Percentage%</div>
                            <div class="score-mini-label">النتيجة</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="header-stats">
                <div class="stat-item">
                    <div class="stat-val clr-green">@Model.StudentDegree / @Model.TotalDegree</div>
                    <div class="stat-lbl">الدرجة</div>
                </div>
                <div class="stat-item">
                    <div class="stat-val clr-blue">@Model.CorrectCount / @Model.TotalQuestions</div>
                    <div class="stat-lbl">إجابات صحيحة</div>
                </div>
                <div class="stat-item">
                    <div class="stat-val clr-red">@(Model.TotalQuestions - Model.CorrectCount)</div>
                    <div class="stat-lbl">إجابات خاطئة</div>
                </div>
            </div>
        </div>

        <!-- Questions -->
        <div class="questions-section-title">📝 تفاصيل الأسئلة والإجابات</div>

        @foreach (var q in Model.Questions)
        {
            string cardClass = q.IsCorrect ? "correct" : "wrong";
            string resultIcon = q.IsCorrect ? "✅" : "❌";
            <div class="question-card @cardClass" style="animation-delay: @(q.QuestionNumber * 0.08)s;">
                <div class="q-header">
                    <span class="q-number-badge">@q.QuestionNumber</span>
                    <div class="q-title">@q.Title</div>
                    <span class="q-degree">@resultIcon @q.Degree درجة</span>
                </div>
                <div class="q-answers">
                    @if (q.DidNotAnswer)
                    {
                        <div style="padding: 10px 16px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 10px; color: #fbbf24; font-size: 13px; font-weight: 700; margin-bottom: 8px; text-align: center;">
                            ⚠️ لم تتم الإجابة على هذا السؤال
                        </div>
                    }
                    @foreach (var ans in q.Answers)
                    {
                        string rowClass = "";
                        string icon = "";
                        string tag = "";

                        if (ans.IsCorrectAnswer && ans.IsStudentAnswer)
                        {
                            rowClass = "is-correct";
                            icon = "✓";
                            tag = "<span class='answer-tag tag-your-correct'>إجابتك ✓</span>";
                        }
                        else if (ans.IsCorrectAnswer)
                        {
                            rowClass = "is-correct";
                            icon = "✓";
                            tag = "<span class='answer-tag tag-correct'>الإجابة الصحيحة</span>";
                        }
                        else if (ans.IsStudentAnswer)
                        {
                            rowClass = "is-student-wrong";
                            icon = "✗";
                            tag = "<span class='answer-tag tag-your-answer'>إجابتك ✗</span>";
                        }

                        <div class="answer-row @rowClass">
                            @if (!string.IsNullOrEmpty(icon))
                            {
                                <span class="answer-icon">@icon</span>
                            }
                            else
                            {
                                <span class="answer-icon"></span>
                            }
                            <span class="answer-text">@ans.AnswerText</span>
                            @Html.Raw(tag)
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="review-footer">
            <a href="@Url.Action("Tests", "Student")" class="btn-back-tests">
                العودة للاختبارات
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path>
                </svg>
            </a>
        </div>
    </div>

    <script>
        // Animate score circle
        setTimeout(() => {
            const circle = document.getElementById('scoreCircle');
            if (circle) {
                const target = parseFloat(circle.getAttribute('data-target'));
                circle.style.strokeDashoffset = target;
            }
        }, 400);
    </script>
</body>
</html>
