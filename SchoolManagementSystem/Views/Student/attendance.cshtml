@using SchoolManagementSystem.ViewModel.Student
@model StudentAttendanceViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الحضور والغياب - @Model.StudentFullName</title>
    <meta name="description" content="سجل الحضور والغياب - بوابة الطالب الإلكترونية">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Student/student_styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Parent/performance.css" asp-append-version="true">
    <style>
        /* KPI stat cards for attendance */
        .attendance-stats-grid {
            display: flex;
            justify-content: center;
            margin-bottom: 32px;
        }

        .attendance-stat-card {
            width: 100%;
            max-width: 320px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            padding: 28px 20px 24px;
            text-align: center;
            box-shadow: 0 4px 24px rgba(67, 135, 171, 0.08), 0 1px 3px rgba(0,0,0,0.04);
            border: 1px solid rgba(255,255,255,0.6);
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.6s ease both;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .attendance-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 36px rgba(67, 135, 171, 0.15);
        }

        .attendance-stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            border-radius: 20px 20px 0 0;
        }

        .attendance-stat-card:nth-child(1) { animation-delay: 0.08s; }
        .attendance-stat-card:nth-child(2) { animation-delay: 0.16s; }
        .attendance-stat-card:nth-child(3) { animation-delay: 0.24s; }
        .attendance-stat-card:nth-child(4) { animation-delay: 0.32s; }

        .attendance-stat-card:nth-child(1)::before { background: linear-gradient(90deg, #43e97b, #38f9d7); }
        .attendance-stat-card:nth-child(2)::before { background: linear-gradient(90deg, #4387AB, #56CCF2); }
        .attendance-stat-card:nth-child(3)::before { background: linear-gradient(90deg, #ef4444, #f97316); }
        .attendance-stat-card:nth-child(4)::before { background: linear-gradient(90deg, #667eea, #764ba2); }

        .stat-ring-wrap {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 16px;
        }

        .stat-ring-wrap svg {
            width: 100px;
            height: 100px;
            transform: rotate(-90deg);
        }

        .stat-ring-bg {
            fill: none;
            stroke: #e8ecf1;
            stroke-width: 8;
        }

        .stat-ring-fill {
            fill: none;
            stroke-width: 8;
            stroke-linecap: round;
            stroke-dasharray: 264;
            stroke-dashoffset: 264;
            transition: stroke-dashoffset 1.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .ring-green .stat-ring-fill  { stroke: #2ecc71; }
        .ring-blue .stat-ring-fill   { stroke: #4387AB; }
        .ring-red .stat-ring-fill    { stroke: #ef4444; }
        .ring-purple .stat-ring-fill { stroke: #764ba2; }

        .stat-ring-label {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
        }

        .stat-ring-value {
            font-size: 22px;
            font-weight: 800;
            color: #1e3a5f;
            line-height: 1;
        }

        .stat-ring-unit {
            font-size: 11px;
            color: #64748b;
            font-weight: 600;
        }

        .stat-card-title {
            font-size: 14px;
            font-weight: 700;
            color: #3a5778;
        }

        /* Status badge in table */
        .absence-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }

        .absence-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #ef4444;
            animation: pulseRed 2s infinite;
        }

        @@keyframes pulseRed {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.3); }
        }

        /* Removed max-width media query for grid */
    </style>
</head>

<body>
    <div class="container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="logo">
                <div class="user-info">
                    <div class="user-avatar">@Model.FirstLetter</div>
                    <span>@Model.StudentFullName</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a asp-controller="Student" asp-action="Index">الصفحة الرئيسية</a></li>
                <li><a asp-controller="Student" asp-action="Schedule">الجدول الدراسي</a></li>
                <li><a asp-controller="Student" asp-action="Grades">الدرجات</a></li>
                <li><a asp-controller="Student" asp-action="Attendance" class="active">الحضور والغياب</a></li>
                <li><a asp-controller="Student" asp-action="Tests">الاختبارات</a></li>
                <li><a asp-controller="Student" asp-action="Level">المستوى</a></li>
                <li><a asp-controller="Student" asp-action="Assignments">الواجبات</a></li>
                <li><a asp-controller="Student" asp-action="Edit">تعديل البيانات</a></li>
            </ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <!-- Main Content -->
        <main class="main-content perf-page">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="page-title">📅 سجل الغياب</h1>
                <p style="color:#64748b; margin-top:8px;">إجمالي أيام الغياب المسجلة في الفصل الحالي</p>
            </div>

            <!-- Stats Grid -->
            <div class="attendance-stats-grid">
                <!-- أيام الغياب -->
                <div class="attendance-stat-card">
                    <div class="stat-ring-wrap ring-red" id="ring-absent"
                         data-value="@Model.AbsenceDays" data-max="30" data-is-pct="false">
                        <svg viewBox="0 0 100 100">
                            <circle class="stat-ring-bg" cx="50" cy="50" r="42"/>
                            <circle class="stat-ring-fill" cx="50" cy="50" r="42"/>
                        </svg>
                        <div class="stat-ring-label">
                            <span class="stat-ring-value" id="val-absent">0</span>
                            <span class="stat-ring-unit">يوم</span>
                        </div>
                    </div>
                    <div class="stat-card-title">إجمالي أيام الغياب</div>
                </div>
            </div>

            <!-- Absence Table -->
            <h2 class="section-title">سجل الغياب</h2>
            <div class="data-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>اليوم</th>
                            <th>التاريخ</th>
                            <th>السبب المرفق</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Absences != null && Model.Absences.Any())
                        {
                            int i = 0;
                            foreach (var absence in Model.Absences)
                            {
                                <tr style="animation: fadeInUp 0.4s ease both; animation-delay: @(i * 0.06)s;">
                                    <td>@absence.DayName</td>
                                    <td>@absence.Date</td>
                                    <td>@absence.Reason</td>
                                    <td>
                                        <span class="absence-badge">
                                            <span class="absence-dot"></span>
                                            غائب
                                        </span>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="text-align:center; padding:32px; color:#64748b;">
                                    لم يتم تسجيل أي أيام غياب في الفصل الحالي 🎉
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script src="~/js/Student/student_script.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const rings = document.querySelectorAll('.stat-ring-wrap');
            const circumference = 2 * Math.PI * 42; // r=42

            rings.forEach(wrap => {
                const value  = parseFloat(wrap.dataset.value)  || 0;
                const max    = parseFloat(wrap.dataset.max)    || 100;
                const isPct  = wrap.dataset.isPct === 'true';
                const fill   = wrap.querySelector('.stat-ring-fill');
                const valEl  = wrap.querySelector('.stat-ring-value');

                // Set dasharray based on our radius
                fill.style.strokeDasharray  = circumference;
                fill.style.strokeDashoffset = circumference;

                const pct = max > 0 ? Math.min(value / max, 1) : 0;

                // Animate ring
                requestAnimationFrame(() => {
                    setTimeout(() => {
                        fill.style.strokeDashoffset = circumference * (1 - pct);
                    }, 80);
                });

                // Animate number
                animateNum(valEl, 0, value, 1300, isPct);
            });

            function animateNum(el, from, to, dur, isPct) {
                let start = null;
                function step(ts) {
                    if (!start) start = ts;
                    const p = Math.min((ts - start) / dur, 1);
                    const ease = 1 - Math.pow(1 - p, 3);
                    const cur = from + ease * (to - from);
                    el.textContent = isPct
                        ? cur.toFixed(1) + '%'
                        : Math.floor(cur).toString();
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = isPct ? to.toFixed(1) + '%' : to.toString();
                }
                requestAnimationFrame(step);
            }
        });
    </script>
</body>

</html>