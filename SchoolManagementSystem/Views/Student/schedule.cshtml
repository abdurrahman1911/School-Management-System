@using SchoolManagementSystem.ViewModel.Student
@model StudentScheduleViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الجدول الدراسي - @Model.StudentFullName</title>
    <meta name="description" content="الجدول الدراسي الأسبوعي - بوابة الطالب الإلكترونية">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Student/student_styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Parent/performance.css" asp-append-version="true">
</head>

<body>
    <div class="container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="logo">
                <div class="user-info">
                    <div class="user-avatar">@Model.FirstLetter</div>
                    <span>@Model.StudentFullName</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a asp-controller="Student" asp-action="Index">الصفحة الرئيسية</a></li>
                <li><a asp-controller="Student" asp-action="Schedule" class="active">الجدول الدراسي</a></li>
                <li><a asp-controller="Student" asp-action="Grades">الدرجات</a></li>
                <li><a asp-controller="Student" asp-action="Attendance">الحضور والغياب</a></li>
                <li><a asp-controller="Student" asp-action="Tests">الاختبارات</a></li>
                <li><a asp-controller="Student" asp-action="Level">المستوى</a></li>
                <li><a asp-controller="Student" asp-action="Assignments">الواجبات</a></li>
                <li><a asp-controller="Student" asp-action="Edit">تعديل البيانات</a></li>
            </ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <!-- Main Content -->
        <main class="main-content perf-page">
            <!-- Weekly Schedule Section -->
            <section class="schedule-section">
                <h2 class="section-title">الجدول الدراسي الأسبوعي</h2>
                
                <div class="schedule-image-container" style="text-align: center; padding: 1rem;">
                    @if (!string.IsNullOrEmpty(Model.SchedulePhotoUrl))
                    {
                        <div class="beautiful-schedule-frame">
                            <img src="@Model.SchedulePhotoUrl" alt="جدول الحصص" class="beautiful-schedule-img">
                        </div>
                    }
                    else
                    {
                        <div style="padding: 3rem; color: #999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 1rem; opacity: 0.5;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <p>لا يوجد جدول متاح حالياً</p>
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>

    <script src="~/js/Student/student_script.js"></script>
</body>

</html>