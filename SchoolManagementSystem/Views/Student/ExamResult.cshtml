@using SchoolManagementSystem.ViewModel.Student
@model ExamResultViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نتيجة الاختبار - @Model.ExamName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e2e8f0;
            padding: 24px;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: 
                radial-gradient(circle at 20% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.08) 0%, transparent 50%);
            z-index: 0;
        }

        .result-container {
            position: relative;
            z-index: 1;
            background: rgba(30, 41, 59, 0.9);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 28px;
            padding: 48px;
            max-width: 520px;
            width: 100%;
            text-align: center;
            animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .result-emoji {
            font-size: 64px;
            margin-bottom: 16px;
            animation: bounceIn 0.8s ease 0.3s both;
        }

        .result-title {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .result-subtitle {
            color: #94a3b8;
            font-size: 15px;
            margin-bottom: 32px;
        }

        /* Score Circle */
        .score-circle-container {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto 32px;
        }

        .score-circle-bg {
            fill: none;
            stroke: rgba(255, 255, 255, 0.06);
            stroke-width: 10;
        }

        .score-circle-fill {
            fill: none;
            stroke-width: 10;
            stroke-linecap: round;
            transform: rotate(-90deg);
            transform-origin: center;
            transition: stroke-dashoffset 2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .score-value {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
        }

        .score-percentage {
            font-family: 'Inter', sans-serif;
            font-size: 42px;
            font-weight: 800;
            line-height: 1;
        }

        .score-label {
            font-size: 13px;
            color: #94a3b8;
            font-weight: 600;
            margin-top: 4px;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 20px;
        }

        .stat-box-value {
            font-family: 'Inter', sans-serif;
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .stat-box-label {
            font-size: 13px;
            color: #94a3b8;
            font-weight: 600;
        }

        .exam-info-row {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-bottom: 32px;
            color: #94a3b8;
            font-size: 14px;
        }

        .exam-info-row span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-back-tests {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 40px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            font-family: 'Cairo', sans-serif;
            font-size: 16px;
            font-weight: 700;
            border: none;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
        }

        .btn-back-tests:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(59, 130, 246, 0.4);
            color: white;
        }

        /* Colors based on grade */
        .grade-excellent .score-percentage { color: #10b981; }
        .grade-excellent .score-circle-fill { stroke: #10b981; }
        .grade-excellent .result-title { color: #10b981; }
        
        .grade-good .score-percentage { color: #3b82f6; }
        .grade-good .score-circle-fill { stroke: #3b82f6; }
        .grade-good .result-title { color: #3b82f6; }
        
        .grade-average .score-percentage { color: #f59e0b; }
        .grade-average .score-circle-fill { stroke: #f59e0b; }
        .grade-average .result-title { color: #f59e0b; }

        .grade-low .score-percentage { color: #ef4444; }
        .grade-low .score-circle-fill { stroke: #ef4444; }
        .grade-low .result-title { color: #ef4444; }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes bounceIn {
            0% { opacity: 0; transform: scale(0.3); }
            50% { transform: scale(1.1); }
            70% { transform: scale(0.95); }
            100% { opacity: 1; transform: scale(1); }
        }

        /* Confetti for high scores */
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            top: -10px;
            z-index: 0;
            animation: confettiFall linear forwards;
        }

        @@keyframes confettiFall {
            to {
                top: 110vh;
                transform: rotate(720deg);
            }
        }
    </style>
</head>

<body>
    @{
        string gradeClass = "grade-average";
        string emoji = "📊";
        string title = "نتيجة مقبولة";
        
        if (Model.Percentage >= 90) {
            gradeClass = "grade-excellent";
            emoji = "🏆";
            title = "ممتاز! أداء رائع";
        } else if (Model.Percentage >= 75) {
            gradeClass = "grade-good";
            emoji = "🌟";
            title = "جيد جداً!";
        } else if (Model.Percentage >= 60) {
            gradeClass = "grade-average";
            emoji = "📊";
            title = "أداء جيد";
        } else {
            gradeClass = "grade-low";
            emoji = "💪";
            title = "تحتاج مزيد من المذاكرة";
        }

        // Circle calculations
        double radius = 75;
        double circumference = 2 * Math.PI * radius;
        double offset = circumference - ((double)Model.Percentage / 100.0 * circumference);
    }

    <div class="result-container @gradeClass">
        <div class="result-emoji">@emoji</div>
        <h1 class="result-title">@title</h1>
        <p class="result-subtitle">تم تسليم اختبار @Model.ExamName بنجاح</p>

        <div class="exam-info-row">
            <span>📚 @Model.SubjectName</span>
        </div>

        <!-- Score Circle -->
        <div class="score-circle-container">
            <svg width="180" height="180" viewBox="0 0 180 180">
                <circle class="score-circle-bg" cx="90" cy="90" r="@radius" />
                <circle class="score-circle-fill" cx="90" cy="90" r="@radius"
                        stroke-dasharray="@circumference"
                        stroke-dashoffset="@circumference"
                        id="scoreCircle"
                        data-target="@offset" />
            </svg>
            <div class="score-value">
                <div class="score-percentage" id="scorePercent">0</div>
                <div class="score-label">بالمئة %</div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-box">
                <div class="stat-box-value" style="color: #10b981;">@Model.StudentDegree / @Model.TotalDegree</div>
                <div class="stat-box-label">الدرجة</div>
            </div>
            <div class="stat-box">
                <div class="stat-box-value" style="color: #3b82f6;">@Model.CorrectCount / @Model.TotalQuestions</div>
                <div class="stat-box-label">إجابات صحيحة</div>
            </div>
        </div>

        <a href="@Url.Action("Tests", "Student")" class="btn-back-tests">
            العودة للاختبارات
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path>
            </svg>
        </a>
    </div>

    <script>
        // Animate score circle
        setTimeout(() => {
            const circle = document.getElementById('scoreCircle');
            const target = parseFloat(circle.getAttribute('data-target'));
            circle.style.strokeDashoffset = target;
        }, 300);

        // Animate percentage number
        const targetPct = @Model.Percentage;
        const scoreEl = document.getElementById('scorePercent');
        let current = 0;
        const duration = 2000;
        const startTime = performance.now();

        function animateScore(timestamp) {
            const elapsed = timestamp - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeProgress = 1 - Math.pow(1 - progress, 4);
            current = easeProgress * targetPct;
            scoreEl.textContent = Math.round(current);
            
            if (progress < 1) {
                requestAnimationFrame(animateScore);
            } else {
                scoreEl.textContent = targetPct;
            }
        }
        
        setTimeout(() => requestAnimationFrame(animateScore), 300);

        // Confetti for high scores
        if (targetPct >= 75) {
            const colors = ['#10b981', '#3b82f6', '#8b5cf6', '#f59e0b', '#ec4899'];
            for (let i = 0; i < 40; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    confetti.style.left = Math.random() * 100 + 'vw';
                    confetti.style.width = (Math.random() * 8 + 4) + 'px';
                    confetti.style.height = (Math.random() * 8 + 4) + 'px';
                    confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.animationDuration = (Math.random() * 3 + 2) + 's';
                    confetti.style.animationDelay = '0s';
                    document.body.appendChild(confetti);
                    
                    setTimeout(() => confetti.remove(), 5000);
                }, i * 100);
            }
        }
    </script>
</body>
</html>
