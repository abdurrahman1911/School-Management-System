@using SchoolManagementSystem.ViewModel.Student
@model StudentTestsViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الاختبارات - @Model.StudentFullName</title>
    <meta name="description" content="الاختبارات والتقييمات - بوابة الطالب الإلكترونية">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/Student/student_styles.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Parent/performance.css" asp-append-version="true">
    
    <style>
        /* Modern Exams Page Styles */
        .exams-page-container {
            font-family: 'Cairo', sans-serif;
        }
        
        /* Stats Header Row (Pills) */
        .exam-stats-row {
            display: flex;
            gap: 16px;
            margin-bottom: 32px;
            flex-wrap: wrap;
        }

        .stat-pill {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 100px;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            animation: fadeIn 0.5s ease both;
            transition: all 0.3s ease;
            cursor: pointer;
            user-select: none;
            opacity: 0.6;
        }

        .stat-pill:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
            opacity: 0.8;
        }

        .stat-pill.selected {
            opacity: 1;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .stat-pill.pill-all.selected { border: 2px solid #64748b; background: #f8fafc; }
        .stat-pill.pill-active.selected { border: 2px solid #10b981; background: #ecfdf5; }
        .stat-pill.pill-upcoming.selected { border: 2px solid #3b82f6; background: #eff6ff; }
        .stat-pill.pill-completed.selected { border: 2px solid #8b5cf6; background: #f5f3ff; }
        .stat-pill.pill-missed.selected { border: 2px solid #ef4444; background: #fef2f2; }

        .stat-pill-label {
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

        .stat-pill-value {
            font-family: 'Inter', sans-serif;
            font-size: 20px;
            font-weight: 800;
            color: #1e293b;
        }
        
        .pill-active .stat-pill-value { color: #10b981; }
        .pill-upcoming .stat-pill-value { color: #3b82f6; }
        .pill-completed .stat-pill-value { color: #8b5cf6; }
        .pill-missed .stat-pill-value { color: #ef4444; }

        /* Exam Cards Grid */
        .exam-cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 24px;
            margin-top: 20px;
        }

        .exam-card {
            background: #ffffff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            border: 1px solid rgba(226, 232, 240, 0.8);
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .exam-card.hide-card {
            display: none !important;
        }

        .exam-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
            border-color: rgba(203, 213, 225, 1);
        }

        /* Card Header */
        .card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .exam-card.active .card-header { background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), rgba(16, 185, 129, 0.01)); }
        .exam-card.upcoming .card-header { background: linear-gradient(135deg, rgba(59, 130, 246, 0.05), rgba(59, 130, 246, 0.01)); }
        .exam-card.completed .card-header { background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(139, 92, 246, 0.01)); }
        .exam-card.missed .card-header { background: linear-gradient(135deg, rgba(239, 68, 68, 0.05), rgba(239, 68, 68, 0.01)); }

        .subject-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #f8fafc;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
            border: 1px solid #e2e8f0;
        }

        .status-pill {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-pill.active { background: rgba(16, 185, 129, 0.1); color: #059669; }
        .status-pill.upcoming { background: rgba(59, 130, 246, 0.1); color: #2563eb; }
        .status-pill.completed { background: rgba(139, 92, 246, 0.1); color: #7c3aed; }
        .status-pill.missed { background: rgba(239, 68, 68, 0.1); color: #dc2626; }

        .pulsing-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #10b981;
            /* Using escaped keyframes name for razor */
            animation: pulseActive 2s infinite;
        }

        @@keyframes pulseActive {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
            70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* Card Body */
        .card-body {
            padding: 24px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }

        .exam-title {
            font-size: 18px;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 12px;
            line-height: 1.4;
        }

        .exam-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #64748b;
            font-size: 14px;
            margin-bottom: 8px;
            font-weight: 500;
        }
        
        .exam-meta svg {
            width: 16px; 
            height: 16px;
            opacity: 0.7;
        }

        .spacer {
            flex-grow: 1;
        }

        /* Card Footer & CTAs */
        .card-footer {
            padding: 20px 24px;
            background: #f8fafc;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .btn-start-exam {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            width: 100%;
            padding: 14px 24px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            font-size: 16px;
            font-weight: 700;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
            border: none;
            cursor: pointer;
        }

        .btn-start-exam:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
            color: white;
        }

        .paper-exam {
            color: #64748b;
            font-weight: 600;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* Grade Display */
        .grade-display {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        
        .grade-text {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        
        .grade-score {
            font-family: 'Inter', sans-serif;
            font-size: 24px;
            font-weight: 800;
        }
        
        .grade-total {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 600;
        }
        
        .grade-bar-bg {
            height: 8px;
            background: #e2e8f0;
            border-radius: 4px;
            overflow: hidden;
            width: 100%;
        }
        
        .grade-bar-fill {
            height: 100%;
            border-radius: 4px;
            transition: width 1s ease-out;
        }
        
        .grade-high .grade-score { color: #10b981; }
        .grade-high .grade-bar-fill { background: linear-gradient(90deg, #34d399, #10b981); }
        
        .grade-med .grade-score { color: #f59e0b; }
        .grade-med .grade-bar-fill { background: linear-gradient(90deg, #fbbf24, #f59e0b); }
        
        .grade-low .grade-score { color: #ef4444; }
        .grade-low .grade-bar-fill { background: linear-gradient(90deg, #f87171, #ef4444); }

        .missed-alert {
            color: #ef4444;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            width: 100%;
        }

        .upcoming-notice {
            color: #3b82f6;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
            width: 100%;
        }
        
        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            background: rgba(255, 255, 255, 0.7);
            border: 2px dashed #cbd5e1;
            padding: 60px 20px;
            border-radius: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }
        
        .empty-state-icon {
            font-size: 48px;
            opacity: 0.5;
        }
        
        .empty-state-text {
            color: #64748b;
            font-size: 18px;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="container exams-page-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="logo">
                <div class="user-info">
                    <div class="user-avatar">@Model.FirstLetter</div>
                    <span>@Model.StudentFullName</span>
                </div>
            </div>
            <ul class="nav-links">
                <li><a asp-controller="Student" asp-action="Index">الصفحة الرئيسية</a></li>
                <li><a asp-controller="Student" asp-action="Schedule">الجدول الدراسي</a></li>
                <li><a asp-controller="Student" asp-action="Grades">الدرجات</a></li>
                <li><a asp-controller="Student" asp-action="Attendance">الحضور والغياب</a></li>
                <li><a asp-controller="Student" asp-action="Tests" class="active">الاختبارات</a></li>
                <li><a asp-controller="Student" asp-action="Level">المستوى</a></li>
                <li><a asp-controller="Student" asp-action="Assignments">الواجبات</a></li>
                <li><a asp-controller="Student" asp-action="Edit">تعديل البيانات</a></li>
            </ul>
            <a asp-controller="Account" asp-action="Logout" class="logout">تسجيل الخروج</a>
        </aside>

        <!-- Main Content -->
        <main class="main-content perf-page">
            <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1 class="page-title">📝 الاختبارات والتقييمات</h1>
                    <p style="color: #64748b; margin-top: 8px;">إدارة ومتابعة جميع الاختبارات الخاصة بك بسهولة</p>
                </div>
            </div>

            <!-- Modern Stats Pills / Filters -->
            <div class="exam-stats-row" id="filters-container">
                <div class="stat-pill pill-all selected" data-filter="all" style="animation-delay: 0s">
                    <div class="stat-pill-label">الكل</div>
                    <div class="stat-pill-value">@(Model.Tests?.Count ?? 0)</div>
                </div>
                <div class="stat-pill pill-active" data-filter="active" style="animation-delay: 0.1s">
                    <div class="stat-pill-label">متاحة الآن</div>
                    <div class="stat-pill-value numberHighlight">@Model.ActiveCount</div>
                </div>
                <div class="stat-pill pill-upcoming" data-filter="upcoming" style="animation-delay: 0.2s">
                    <div class="stat-pill-label">قادمة</div>
                    <div class="stat-pill-value numberHighlight">@Model.UpcomingCount</div>
                </div>
                <div class="stat-pill pill-completed" data-filter="completed" style="animation-delay: 0.3s">
                    <div class="stat-pill-label">مكتملة</div>
                    <div class="stat-pill-value numberHighlight">@Model.CompletedCount</div>
                </div>
                <div class="stat-pill pill-missed" data-filter="missed" style="animation-delay: 0.4s">
                    <div class="stat-pill-label">فائتة</div>
                    <div class="stat-pill-value numberHighlight">@Model.MissedCount</div>
                </div>
            </div>

            <!-- Exam Cards Grid -->
            <h2 class="section-title">الاختبارات الخاصة بك</h2>
            <div class="exam-cards-grid" id="exam-cards-container">
                @if (Model.Tests != null && Model.Tests.Any())
                {
                    int i = 0;
                    foreach (var test in Model.Tests)
                    {
                        <div class="exam-card @test.Status" data-status="@test.Status" style="animation: fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both; animation-delay: @(i * 0.1)s;">
                            <!-- Header -->
                            <div class="card-header">
                                <span class="subject-badge">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                                    @test.SubjectName
                                </span>
                                
                                @if (test.Status == "active") {
                                    <span class="status-pill active"><span class="pulsing-dot"></span> متاح الآن</span>
                                } else if (test.Status == "upcoming") {
                                    <span class="status-pill upcoming">قادم</span>
                                } else if (test.Status == "completed") {
                                    <span class="status-pill completed">مكتمل</span>
                                } else if (test.Status == "missed") {
                                    <span class="status-pill missed">فائت</span>
                                }
                            </div>
                            
                            <!-- Body -->
                            <div class="card-body">
                                <h3 class="exam-title">@test.Title</h3>
                                <div class="exam-meta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @test.Date
                                </div>
                                <div class="exam-meta">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    إجمالي الدرجات: @test.TotalMarks
                                </div>
                                <div class="spacer"></div>
                            </div>
                            
                            <!-- Footer actions -->
                            <div class="card-footer">
                                @if (test.Status == "active")
                                {
                                    <a asp-controller="Student" asp-action="TakeExam" asp-route-examId="@test.Id" class="btn-start-exam">
                                        بدء الاختبار
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                                    </a>
                                }
                                else if (test.Status == "completed")
                                {
                                    string gradeClass = "grade-med";
                                    if (test.Percentage >= 85) gradeClass = "grade-high";
                                    else if (test.Percentage < 60) gradeClass = "grade-low";
                                    
                                    <div class="grade-display @gradeClass">
                                        <div class="grade-text">
                                            <span style="font-weight: 700; color: #475569; font-size: 14px;">درجتك:</span>
                                            <div>
                                                <span class="grade-score">@test.Grade</span>
                                                <span class="grade-total">/ @test.TotalMarks</span>
                                            </div>
                                        </div>
                                        <div class="grade-bar-bg">
                                            <div class="grade-bar-fill" style="width: @(test.Percentage)%"></div>
                                        </div>
                                    </div>
                                    @if (test.CanReview)
                                    {
                                        <a asp-controller="Student" asp-action="ExamReview" asp-route-examId="@test.Id" 
                                           style="display: inline-flex; justify-content: center; align-items: center; gap: 8px; width: 100%; padding: 12px 20px; margin-top: 12px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; font-size: 14px; font-weight: 700; border-radius: 12px; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);"
                                           onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 25px rgba(139, 92, 246, 0.4)';"
                                           onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(139, 92, 246, 0.3)';">
                                            📋 مراجعة الاختبار
                                        </a>
                                    }
                                    else
                                    {
                                        <div style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 10px 16px; margin-top: 12px; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 10px; color: #f59e0b; font-size: 13px; font-weight: 600;">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                            ستتاح تفاصيل الاختبار بعد انتهاء اليوم
                                        </div>
                                    }
                                }
                                else if (test.Status == "upcoming")
                                {
                                    <div class="upcoming-notice">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                        سيفتح في الموعد المحدد
                                    </div>
                                }
                                else if (test.Status == "missed")
                                {
                                    <div class="missed-alert">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                        انتهى وقت الاختبار (0 / @test.TotalMarks)
                                    </div>
                                }
                            </div>
                        </div>
                        i++;
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon">📚</div>
                        <div class="empty-state-text">لا توجد أي اختبارات مضافة حالياً. استمتع بوقتك!</div>
                    </div>
                }
            </div>
        </main>
    </div>

    <script src="~/js/Student/student_script.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Animate number pills
            const highlights = document.querySelectorAll('.numberHighlight');
            highlights.forEach(el => {
                const target = parseInt(el.innerText, 10) || 0;
                animateValue(el, 0, target, 1000);
            });
            
            // Animate grade bars width on load
            setTimeout(() => {
                const bars = document.querySelectorAll('.grade-bar-fill');
                bars.forEach(bar => {
                    const width = bar.style.width;
                    bar.style.width = '0';
                    setTimeout(() => {
                        bar.style.width = width;
                    }, 100);
                });
            }, 300);

            // Filtering logic
            const filterPills = document.querySelectorAll('.stat-pill');
            const examCards = document.querySelectorAll('.exam-card');
            
            filterPills.forEach(pill => {
                pill.addEventListener('click', () => {
                    // Remove selected class from all
                    filterPills.forEach(p => p.classList.remove('selected'));
                    // Add selected class to clicked
                    pill.classList.add('selected');
                    
                    const filterValue = pill.getAttribute('data-filter');
                    
                    examCards.forEach(card => {
                        if (filterValue === 'all') {
                            card.classList.remove('hide-card');
                        } else {
                            if (card.getAttribute('data-status') === filterValue) {
                                card.classList.remove('hide-card');
                            } else {
                                card.classList.add('hide-card');
                            }
                        }
                    });
                });
            });
        });

        function animateValue(obj, start, end, duration) {
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                // Ease out quint
                const easeProgress = 1 - Math.pow(1 - progress, 5);
                const current = start + easeProgress * (end - start);
                
                obj.innerHTML = Math.floor(current);
                
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                } else {
                    obj.innerHTML = end;
                }
            };
            window.requestAnimationFrame(step);
        }
    </script>
</body>

</html>