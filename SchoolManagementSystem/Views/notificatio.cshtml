                        </tr>

                        <tr>
                            <td>مدير أمن المعلومات</td>
                            <td>حذف معلم</td>
                            <td>محمد إبراهيم</td>
                            <td>2026/06/29 - 11:15 AM</td>
                        </tr>

                        <tr>
                            <td>المدير</td>
                            <td>تعديل بيانات طالب</td>
                            <td>يوسف خالد</td>
                            <td>2026/06/29 - 12:20 PM</td>
                        </tr>

                        <tr>
                            <td>مدير أمن المعلومات</td>
                            <td>إضافة مشرف</td>
                            <td>محمود أحمد</td>
                            <td>2026/06/28 - 02:45 PM</td>
                        </tr>

                        <tr>
                            <td>المدير</td>
                            <td>حذف طالب</td>
                            <td>عمر حسن</td>
                            <td>2026/06/28 - 04:10 PM</td>
                        </tr>

                        <tr>
                            <td>مدير أمن المعلومات</td>
                            <td>تعديل بيانات معلم</td>
                            <td>سارة علي</td>
                            <td>2026/06/27 - 09:00 AM</td>
                        </tr>

                        <tr>
                            <td>مدير أمن المعلومات</td>
                            <td>إضافة طالب</td>
                            <td>عبدالله محمد</td>
                            <td>2026/06/27 - 01:35 PM</td>
                        </tr>

                        <tr>
                            <td>المدير</td>
