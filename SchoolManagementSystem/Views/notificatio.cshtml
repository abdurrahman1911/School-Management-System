@{
    ViewData["Title"] = "الإشعارات";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Admin/Notifications.css" />
    <link rel="stylesheet" href="~/css/Admin/res.css" />
</head>

<body>

    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar">

        <div class="logo">
            <div class="user-info">

                <div class="user-avatar">
                    م
                </div>

                <span>عمر خالد وليد الشافعي </span>

            </div>
        </div>

        <ul class="nav-links">
            <li><a asp-controller="Owner" asp-action="Dashboard">الصفحة الرئيسية</a></li>
            <li><a asp-controller="Owner" asp-action="Notes">الملاحظات</a></li>
            <li><a asp-controller="Owner" asp-action="Notifications" class="active">الإشعارات</a></li>
            <li><a asp-controller="Owner" asp-action="Successandfailure">النجاح والرسوب</a></li>
            <li><a asp-controller="Owner" asp-action="Student">الطلاب</a></li>
            <li><a asp-controller="Owner" asp-action="Teachers">المعلمين</a></li>
