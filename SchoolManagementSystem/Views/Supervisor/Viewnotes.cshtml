@model SchoolManagementSystem.ViewModel.Teacher.NoteDisplayViewModel

@{
    ViewData["Title"] = "الملاحظات الواردة";
}
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="~/css/Supervisor/viewnotes.css" />
<link rel="stylesheet" href="~/css/Supervisor/sidebar.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<link rel="stylesheet" href="~/css/Supervisor/res.css" />

<style>
            .user-avatar {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                overflow: hidden;
                background: #fff;
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 10px;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    display: block;
                    object-fit: cover;
                    border-radius: 50%;
                    margin: 0;
                    padding: 0;
                }

    .password-field {
        position: relative;
        display: flex;
        align-items: center;
    }

        .password-field .toggle {
            position: absolute;
            left: 10px;
            cursor: pointer;
            color: #777;
        }
</style>
</head>
<div class="dashboard-container" dir="rtl">

    <button class="menu-toggle" id="menuToggle">
        <i class="fas fa-bars"></i>
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <aside class="sidebar">
        <div class="admin">
            <div class="user-info">
                <div class="user-avatar">
                    @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                    {
                        <text>@Model.NavigationInfo.FullName[0]</text>
                    }
                    else
                    {
                        <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                    }

                </div>

                <h4>
                    <a asp-controller="Supervisor" asp-action="SupervisorProfile">
                        @(Model.NavigationInfo?.FullName ?? "مشرف")
                    </a>
                </h4>
            </div>
        </div>

        <nav>
            <a asp-controller="Supervisor" asp-action="ViewNotes" class="active">
                الملاحظات والتنبيهات
            </a>

            <a asp-controller="Supervisor" asp-action="StudentPage">
                الطلاب
            </a>

            <a asp-controller="Supervisor" asp-action="TeachersPage">
                المعلمون
            </a>

            <a asp-controller="Supervisor" asp-action="StudentsTable">
                جدول الطلاب
            </a>

            <a asp-controller="Supervisor" asp-action="TeachersTable">
                جدول المعلمين
            </a>

      
            <a asp-controller="Supervisor" asp-action="TeachersAbsence">
                غياب المعلمين
            </a>

            <a asp-controller="Supervisor" asp-action="StudentsAbsence">
                غياب الطلاب
            </a>

            <a asp-controller="Supervisor" asp-action="Notes">
                الملاحظات
            </a>

            <a asp-controller="Supervisor" asp-action="EditProfile">
                تعديل البيانات
            </a>
        </nav>

        <a asp-controller="Account" asp-action="Logout" class="logout">
            تسجيل الخروج
        </a>
    </aside>

    <div class="main-content">

        <div class="content-card">

            <div class="header-section">
                <h2>
                    <i class="bi bi-journal-text"></i>
                    الملاحظات الواردة من الإدارة
                </h2>

                <p>
                    هنا تجد جميع الملاحظات والتنبيهات المرسلة إليك من الإدارة.
                </p>
            </div>

            <div class="table-container">

                <table class="notes-table">
                    <thead>
                        <tr>
                            <th>تاريخ الإضافة</th>
                            <th>الملاحظة</th>
                            <th>كاتب الملاحظة</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Notes != null && Model.Notes.Any())
                        {
                            @foreach (var note in Model.Notes)
                            {
                                <tr>
                                    <!-- استخدام الصيغة الجاهزة للتاريخ من الـ ViewModel -->
                                    <td>@note.FormattedAddedDate</td>
                                    <td>@note.NoteDetails</td>
                                    <td>@note.WriterName</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" style="text-align: center; padding: 20px;">
                                    لا توجد ملاحظات واردة حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="notes-count">
                إجمالي الملاحظات : @(Model.Notes?.Count ?? 0)
            </div>

        </div>

    </div>

</div>

<script>
         const menuToggle = document.getElementById("menuToggle");
    const sidebar = document.querySelector(".sidebar");
    const overlay = document.getElementById("sidebarOverlay");

    menuToggle.addEventListener("click", () => {
    sidebar.classList.add("active");
    overlay.classList.add("active");
    menuToggle.classList.add("hidden"); // اخفاء الزر
    });

    overlay.addEventListener("click", () => {
    sidebar.classList.remove("active");
    overlay.classList.remove("active");
    menuToggle.classList.remove("hidden"); // اظهار الزر
    });
</script>