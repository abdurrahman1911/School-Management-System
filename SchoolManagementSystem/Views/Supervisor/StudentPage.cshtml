@model SchoolManagementSystem.ViewModel.Supervisor.StudentPageViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطلاب</title>
    <!-- Page specific styles: Handles layout for selectors and tables -->
    <link rel="stylesheet" href="~/css/Supervisor/studentPage.css" />
    <!-- Icons library: Standard FontAwesome set for UI consistency -->
    <link rel="stylesheet" href="~/css/Supervisor/sidebar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/Supervisor/res.css" />
    <style>
            .user-avatar {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                overflow: hidden;
                background: #fff;
                display: flex;
                justify-content: center;
                align-items: center;
                margin: 0 auto 10px;
            }

                .user-avatar img {
                    width: 100%;
                    height: 100%;
                    display: block;
                    object-fit: cover;
                    border-radius: 50%;
                    margin: 0;
                    padding: 0;
                }

            .password-field {
                position: relative;
                display: flex;
                align-items: center;
            }

                .password-field .toggle {
                    position: absolute;
                    left: 10px;
                    cursor: pointer;
                    color: #777;
                }

            nav a {
                display: block !important;
                text-decoration: none !important;
                color: #000 !important;
                background: #c8d8e4 !important;
                margin-bottom: 10px !important;
                padding: 5px 10px !important;
                text-align: center !important;
                border-radius: 5px !important;
                transition: 0.3s !important;
                width: 100%;
                margin-top: -3px;
            }
    </style>

</head>
<body>
    <button class="menu-toggle" id="menuToggle">
        ☰
    </button>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="layout">
        <!-- Main Dashboard Content -->
        <main class="content">
            <div class="box">

                <!-- Filtering Section: User selects Stage and Grade to trigger dynamic updates -->
                <div class="selectors">
                    <div>
                        <label>اختيار المرحلة</label>
                        <select id="stageSelect" onchange="loadFilteredData()">
                            <option value="">اختر المرحلة</option>
                            @foreach (var stage in Model.Stages)
                            {
                                <option value="@stage.Id" selected="@(Model.SelectedStageId == stage.Id)">@stage.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label>اختيار الصف</label>
                        <select id="gradeSelect" onchange="loadFilteredData()">
                            <option value="">اختر الصف</option>
                            @foreach (var cls in Model.Classes)
                            {
                                <option value="@cls.Id" selected="@(Model.SelectedLevelId == cls.Id)">@cls.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <!--
                    AJAX Update Target:
                    The 'tableContainer' div is the specific DOM element replaced by the JavaScript
                    logic when filters are changed.
                -->
                <div id="tableContainer">
                    <table>
                        <thead>
                            <tr>
                                <th>اسم الطالب / الطالبة</th>
                            </tr>
                        </thead>
                        <tbody id="studentsTable">
                            @if (Model.Students != null && Model.Students.Any())
                            {
                                foreach (var student in Model.Students)
                                {
                                    <tr>
                                        <td>@student.FullName</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <!--
                                    Empty State UI:
                                    Displayed as a fallback when no records match the criteria
                                -->
                                <tr>
                                    <td style="text-align:center; padding: 20px;">لا يوجد طلاب حالياً لهذا الاختيار</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- Common Sidebar: Consistent across supervisor dashboard modules -->
        <aside class="sidebar">
            <div class="logo">
                <div class="admin">

                <div class="user-info">
                    <div class="user-avatar">
                        @if (string.IsNullOrEmpty(Model.NavigationInfo.ProfilePhotoUrl))
                        {
                            <text>@Model.NavigationInfo.FullName[0]</text>
                        }
                        else
                        {
                            <img src="/images/users/@Model.NavigationInfo.ProfilePhotoUrl" alt="Profile Photo" />
                        }

                        
                    </div>
                    <h4>
                        <a asp-controller="Supervisor" asp-action="SupervisorProfile">
                            @(Model.NavigationInfo?.FullName ?? "مشرف")
                        </a>
                    </h4>
                </div>
            </div>
            </div>

            <nav>
                <a asp-controller="Supervisor" asp-action="Viewnotes">الملاحظات والتنبيهات </a>

                <a asp-controller="Supervisor" asp-action="StudentPage" class="active">
                    الطلاب
                </a>
                <!-- Active Link for Teachers Page -->
                <a asp-controller="Supervisor" asp-action="TeachersPage">
                    المعلمون
                </a>
                <a asp-controller="Supervisor" asp-action="StudentsTable">
                    جدول الطلاب
                </a>
                <a asp-controller="Supervisor" asp-action="TeachersTable">
                    جدول المعلمين
                </a>
               
                <a asp-controller="Supervisor" asp-action="TeachersAbsence">
                    غياب المعلمين
                </a>
                <a asp-controller="Supervisor" asp-action="StudentsAbsence">
                    غياب الطلاب
                </a>
                <a asp-controller="Supervisor" asp-action="Notes">
                    الملاحظات
                </a>
                <a asp-controller="Supervisor" asp-action="EditProfile">
                    تعديل البيانات
                </a>
            </nav>

            <a asp-controller="Account" asp-action="Logout" class="logout">
                تسجيل الخروج
            </a>
        </aside>
    </div>

    <!--
        JS Module:
        Handles the AJAX call to loadFilteredData() triggered by dropdown changes.
    -->
    <script src="~/js/Supervisor/studentPage.js"></script>

    <script>
        const menuToggle = document.getElementById("menuToggle");
        const sidebar = document.querySelector(".sidebar");
        const overlay = document.getElementById("sidebarOverlay");

        menuToggle.addEventListener("click", () => {
        sidebar.classList.add("active");
        overlay.classList.add("active");
        menuToggle.classList.add("hidden"); // اخفاء الزر
        });

        overlay.addEventListener("click", () => {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        menuToggle.classList.remove("hidden"); // اظهار الزر
        });
    </script>
</body>
</html>